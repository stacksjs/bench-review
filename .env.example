# ─────────────────────────────────────────────────────────────────────────────
# bench-review environment
#
# Generated from the real .env with every value blanked (bench-review#55). The
# previous example described a Postgres app on port 3000 that this has never
# been, so following it produced a broken install.
#
# Keys marked REQUIRED IN PROD have no safe default: the app starts without
# them and fails later, in ways that are easy to miss.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Bench Review"
APP_ENV=local

# REQUIRED IN PROD. Signs sessions and derives the admin-queue author_ref
# pseudonyms. Generate with `./buddy key:generate`. Rotating it invalidates
# every session and changes every author_ref.
APP_KEY=

# REQUIRED IN PROD. FULL url including the scheme — `https://benchreview.com`,
# not `benchreview.com`.
#
# Two consumers, one contract. app/ helpers interpolate this whole
# (`${APP_URL}/article/12`), so the scheme has to be here. The framework wants
# a bare host and prepends `https://` itself, so config/app.ts strips the
# scheme on the way through. Setting a bare host here instead breaks the
# emails, which is the direction that fails silently.
APP_URL=http://localhost:4000

APP_MAINTENANCE=false

# Static site (stx dev server) and the API process. They are separate ports and
# both are needed; PORT_API was missing from the old example entirely.
PORT=4000
PORT_API=4008

DEBUG=true

# SQLite in every environment today. DB_DATABASE is the file path, and it is
# what the backup job snapshots.
DB_CONNECTION=sqlite
DB_DATABASE=database/stacks.sqlite

# ── Uploads ──────────────────────────────────────────────────────────────────
# REQUIRED IN PROD: set this to `s3`.
#
# `local` writes under storage/ and returns /storage/... urls that nothing
# serves, on a filesystem a redeploy replaces — so in production every review
# photo and avatar 404s and is then destroyed. /api/health reports a degraded
# status when it finds local in production, rather than letting that be
# discovered by a user.
FILESYSTEM_DISK=local

AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_PROFILE=
AWS_BUCKET=
AWS_S3_PREFIX=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Mail ─────────────────────────────────────────────────────────────────────
# REQUIRED IN PROD. SMTP is on the critical path: password resets, review
# moderation notices, and the ADMIN SECOND-FACTOR CODE. Admin login fails
# closed when mail cannot be sent, so a broken mailer locks the admin panel.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME="Bench Review"
MAIL_FROM_ADDRESS=

# REQUIRED IN PROD. Where "Report a review" and "Legal request" contact
# messages go. The judicial-privacy response window is 72 hours, so this has to
# be an inbox somebody reads daily. Falls back to CONTACT_EMAIL when unset.
LEGAL_CONTACT_EMAIL=
CONTACT_EMAIL=

# ── Abuse prevention ─────────────────────────────────────────────────────────
# REQUIRED IN PROD, both. Without the secret the server accepts any signup;
# without the site key the form ships with no widget. The SITE key is read at
# BUILD time, so it has to be present on the build runner, not just at runtime.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Operations ───────────────────────────────────────────────────────────────
# Where the daily backup job stages its snapshot before upload. With
# FILESYSTEM_DISK=s3 the file is shipped offsite; on local it stays here, on
# the same machine as the database, which is not a backup.
BACKUP_DIR=storage/backups

# Optional. A webhook (Slack/Discord) that reportError posts failures to.
# Without it failures go to the log only, which nobody is watching.
ERROR_WEBHOOK_URL=

LOG_DIR=storage/logs
LOG_RETENTION_DAYS=30

# ── Queue ────────────────────────────────────────────────────────────────────
# `sync` runs jobs inline and makes mail.queue() inert, which is why
# transactional mail is detached by hand (app/Support/sendMail.ts). Switching
# to `database` plus a worker is the better answer.
QUEUE_DRIVER=sync
QUEUE_PREFIX=
QUEUE_CONCURRENCY=
QUEUE_LOG_LEVEL=
QUEUE_WORKER_CONCURRENCY=
QUEUE_FAILED_DRIVER=

# ── Search ───────────────────────────────────────────────────────────────────
SEARCH_ENGINE_DRIVER=meilisearch
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_APP_ENV=local
FRONTEND_APP_URL="${APP_URL}"
FRONTEND_STRIPE_PUBLIC_KEY=

STRIPE_SECRET_KEY=
