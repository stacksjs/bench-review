<script server>
/**
 * Icon — resolves a name to an inline SVG.
 *
 * bench had 49 `<Icon name="…">` tags across 24 files and no Icon component:
 * not here, and not in `@stacksjs/components`, which ships 44 components and
 * none of them an icon. An unresolved PascalCase tag is dropped silently
 * rather than erroring, so every one of them rendered an empty element and
 * nothing in lint, tsc, the build or the gate saw it (bench-review#91).
 *
 * ## Why the markup is composed as a string
 *
 * `:if` is NOT resolved at build time — verified on a probe page: both
 * branches ship with their `:if` attribute and an `x-cloak`, to be decided in
 * the browser. Branching on the name that way would send all fifteen icon
 * bodies with every icon and make a static glyph depend on JS. `{!! !!}` does
 * emit raw markup at build, so the whole element is assembled here and
 * emitted once.
 *
 * ## Why the classes go on a wrapper, not the <svg>
 *
 * `bindClass` reads `el.className` as its base (signals.js:3159). On an SVG
 * that is an `SVGAnimatedString`, not a string, so the merge produces
 * "[object SVGAnimatedString] text-blue-600" and drops the static classes.
 * (It no longer throws outright — the write is guarded at :3216 — but the
 * result is still wrong.) Several call sites put `x-class` on an Icon, so the
 * wrapper takes class and x-class and the svg inherits colour through
 * `currentColor`.
 *
 * Names are the ones already in use, Lucide-style. A collection prefix is
 * stripped, so `heroicons:star-solid` resolves to the local `star-solid`.
 */

const STROKE = 'fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"'
const SOLID = 'fill="currentColor" stroke="none"'

const ICONS = {
  'check': [STROKE, '<polyline points="20 6 9 17 4 12"/>'],
  'x': [STROKE, '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>'],
  'menu': [STROKE, '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>'],
  'chevron-down': [STROKE, '<polyline points="6 9 12 15 18 9"/>'],
  'chevron-left': [STROKE, '<polyline points="15 18 9 12 15 6"/>'],
  'chevron-right': [STROKE, '<polyline points="9 18 15 12 9 6"/>'],
  'search': [STROKE, '<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>'],
  'map-pin': [STROKE, '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>'],
  'bookmark': [STROKE, '<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>'],
  'star': [STROKE, '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>'],
  'star-solid': [SOLID, '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>'],
  'share-2': [STROKE, '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>'],
  'pencil': [STROKE, '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/>'],
  'mail': [STROKE, '<rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22 6 12 13 2 6"/>'],
  'file-check': [STROKE, '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 15 11 17 15 13"/>'],
  'ellipsis-vertical': [SOLID, '<circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/>'],
}

const rawName = String($props.name || '')
const key = rawName.includes(':') ? rawName.slice(rawName.indexOf(':') + 1) : rawName
const entry = ICONS[key]
const size = String($props.size || 20)
const cls = String($props.class || $props.className || '')
const xcls = String($props['x-class'] || '').replace(/"/g, '&quot;')
const label = String($props.label || '').replace(/"/g, '&quot;')
const xattr = xcls ? ' x-class="' + xcls + '"' : ''
const a11y = label ? ' role="img" aria-label="' + label + '"' : ' aria-hidden="true"'
const svg = entry ? '<svg width="' + size + '" height="' + size + '" viewBox="0 0 24 24" ' + entry[0] + '>' + entry[1] + '</svg>' : ''

// Every const above is a single line and nothing here calls a local helper
// function: a multi-line export came back as "[object Object]" and one built
// by calling a function came back as "[object Promise]". Single-line
// expressions — concat, method call, ternary, map lookup — all survive.
// An unknown name renders an HTML comment rather than a broken glyph, so a
// typo is findable in the built page instead of silent.
export const html = entry ? '<span class="inline-flex items-center justify-center shrink-0 ' + cls + '"' + xattr + a11y + '>' + svg + '</span>' : '<!-- icon not found: ' + key.replace(/[^a-zA-Z0-9:_-]/g, '') + ' -->'
</script>
{!! html !!}
