<script client>
  // Global confirmation modal. Mounted once per layout. Renders whenever
  // the confirm store is open; the buttons settle the promise that the
  // calling confirmStore.ask(...) is awaiting.
  //
  // Visibility: ALL overlay/positioning classes live in the derived TRUE
  // branch (not the static class). If the overlay classes were static,
  // the modal would paint as a full-screen overlay before the client
  // binding hides it (a visible empty-modal flash on every page load).
  // The backdrop is the overlay's own bg; clicking it dismisses,
  // clicking the panel does not.
  //
  // The class expressions live in deriveds (not inline x-class ternaries)
  // deliberately: the include compiler only registers a component's scope
  // variables when the script calls state/derived/effect. A useStore-only
  // script gets an EMPTY scope registration, every binding referencing
  // confirmStore silently evaluates to '', and the dialog paints as a
  // naked unhidden shell at the bottom of every page. The deriveds keep
  // this component on the healthy compile path.
  const confirmStore = useStore('confirm')
  const overlayClass = derived<string>(() =>
    confirmStore.open() ? 'fixed inset-0 z-[1100] flex items-center justify-center p-4 bg-black/40' : 'hidden')
  const acceptClass = derived<string>(() =>
    confirmStore.danger() ? 'bg-red-600 hover:bg-red-500' : 'bg-blue-600 hover:bg-blue-700')

  // ── Modal keyboard semantics ──────────────────────────────────────
  //
  // This is a real modal — it blocks the page and settles a promise the
  // caller is awaiting — so it owes the three things a modal owes a keyboard
  // user, none of which it had:
  //
  //   Escape closes it. Without this the only way out is a mouse.
  //   Focus moves INTO it on open. Otherwise focus stays wherever it was, on
  //     a control now behind a scrim, and a screen reader announces nothing.
  //   Focus stays inside while open, and is restored on close. Without the
  //     trap, Tab walks straight out into the page underneath — the dialog is
  //     still visually on top, so the user is typing into something they
  //     can't see.
  //
  // Listener is on `document` and gates on `confirmStore.open()` rather than
  // being added/removed per open: the overlay is only hidden via a class, so
  // there is no mount/unmount edge to hang add/remove off, and a single
  // always-registered handler can't leak.
  const dialogId = 'bench-confirm-dialog'
  let restoreFocusTo: HTMLElement | null = null

  function focusableIn(root: Element): HTMLElement[] {
    return Array.from(
      root.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'),
    ).filter(el => !(el as HTMLButtonElement).disabled) as HTMLElement[]
  }

  effect(() => {
    if (typeof document === 'undefined') return
    const isOpen = confirmStore.open()
    const panel = document.getElementById(dialogId)
    if (!panel) return
    if (isOpen) {
      // Remember where focus came from so it can go back on close, then move
      // to Cancel — the non-destructive choice, so a stray Enter can't confirm
      // a delete the user never read.
      restoreFocusTo = document.activeElement as HTMLElement | null
      const targets = focusableIn(panel)
      if (targets.length) setTimeout(() => targets[0].focus(), 0)
    }
    else if (restoreFocusTo) {
      const back = restoreFocusTo
      restoreFocusTo = null
      setTimeout(() => back.focus(), 0)
    }
  })

  if (typeof document !== 'undefined') {
    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (!confirmStore.open()) return
      if (event.key === 'Escape') {
        event.preventDefault()
        confirmStore.dismiss()
        return
      }
      if (event.key !== 'Tab') return
      const panel = document.getElementById(dialogId)
      if (!panel) return
      const targets = focusableIn(panel)
      if (!targets.length) return
      const first = targets[0]
      const last = targets[targets.length - 1]
      const active = document.activeElement
      // Wrap at both ends, and pull focus back in if it has escaped the panel
      // entirely (browser chrome, a click on the backdrop, an SPA swap).
      if (!panel.contains(active)) {
        event.preventDefault()
        first.focus()
      }
      else if (event.shiftKey && active === first) {
        event.preventDefault()
        last.focus()
      }
      else if (!event.shiftKey && active === last) {
        event.preventDefault()
        first.focus()
      }
    })
  }
</script>

<div
  x-class="overlayClass()"
  @click="confirmStore.dismiss()"
>
  <div
    id="bench-confirm-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="bench-confirm-title"
    aria-describedby="bench-confirm-message"
    @click="$event.stopPropagation()"
    class="p-6 max-w-md w-full bg-white border border-gray-200 rounded-2xl shadow-xl"
  >
    <h2 id="bench-confirm-title" class="font-semibold text-gray-900 text-lg" :text="confirmStore.title()"></h2>
    <p id="bench-confirm-message" class="mt-2 text-gray-600 text-sm" :text="confirmStore.message()"></p>
    <div class="flex gap-3 justify-end mt-6">
      <button
        type="button"
        @click="confirmStore.dismiss()"
        class="px-4 py-2 font-medium text-gray-700 text-sm bg-white hover:bg-gray-50 border border-gray-300 rounded-lg transition-colors"
        :text="confirmStore.cancelLabel()"
      ></button>
      <button
        type="button"
        @click="confirmStore.accept()"
        class="px-4 py-2 font-medium text-sm text-white rounded-lg transition-colors"
        x-class="acceptClass()"
        :text="confirmStore.confirmLabel()"
      ></button>
    </div>
  </div>
</div>
