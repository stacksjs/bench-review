<script client>
  // Comments section under an article (bench-review#44).
  //
  // Renders below the article body. Self-contained:
  //   - resolves the review id with useRoute().params (same pattern as
  //     ArticleEdit; the pathname fallback below is for shell-served
  //     pages, where the injected param is the literal '_shell')
  //   - fetches /api/reviews/{id}/comments on mount
  //   - composer for signed-in users (auto-publishing; comments hit
  //     status='published' immediately per the action body)
  //   - per-row Delete for the author's own comments
  //
  // Anonymity follows the same flag as the parent review:
  // publicReviewerFor on the server returns `author.id = null` for
  // anonymized comments and the link doesn't render here either.

  const authStore = useStore('auth')
  const reviewsStore = useStore('reviews')
  const toast = useStore('toast')
  const confirmStore = useStore('confirm')

  interface CommentRow {
    id: number
    body: string
    created_at: string | null
    author: { id: number | null, name: string, role_label: string | null }
    /** Server-stated ownership. author.id is null on anonymous rows, so this is
     *  the only reliable signal that the viewer wrote this comment. */
    is_mine?: boolean
  }

  function resolveReviewId(): number {
    if (typeof window === 'undefined') return 0
    // stx-standards 9.10: route params come from useRoute(), never from
    // window.stx._rp and never by re-parsing the URL. useRoute().params reads
    // a signal the runtime primes from the id the build injects into <head>,
    // ahead of the runtime itself, so it is populated on a hard reload too —
    // which is what the older note about _rp being unset was working around.
    // useRoute is auto-imported; do not hand-import it.
    const fromRouter = Number(useRoute().params.id)
    if (Number.isFinite(fromRouter) && fromRouter > 0) return fromRouter
    const m = window.location.pathname.match(/^\/article\/(\d+)/)
    return m ? Number(m[1]) : 0
  }

  const reviewIdForComments = resolveReviewId()
  const comments = state<CommentRow[]>([])
  const commentsLoaded = state<boolean>(false)
  const commentDraft = state<string>('')
  const commentAnon = state<boolean>(false)
  const commentSubmitting = state<boolean>(false)
  const commentError = state<string>('')
  const commentFieldError = state<boolean>(false)
  // Re-entry guard for per-row Delete (these buttons live in a :for, so a
  // signal-call-driven per-row visual would break the loop — guard in JS).
  const deletingId = state<number | null>(null)

  // Numbered pagination (the house pattern — not load-more). The endpoint
  // has returned the canonical paginator since bench-review#44; this side
  // never caught up and asked for one page of fifty, so a thread longer than
  // that simply lost its tail with nothing on screen to suggest more existed.
  const PER_PAGE = 20
  const commentsPage = state<number>(1)
  const commentsLastPage = state<number>(1)
  const commentsTotal = state<number>(0)

  async function loadComments(page = 1): Promise<void> {
    if (!reviewIdForComments) return
    try {
      const res = await authStore.authFetch(`/api/reviews/${reviewIdForComments}/comments?page=${page}&per_page=${PER_PAGE}`)
      if (!res.ok) return
      const json = await res.json() as { data?: CommentRow[], current_page?: number, last_page?: number, total?: number } | CommentRow[]
      // The Array.isArray fallback keeps us safe if the endpoint shape ever
      // regresses to a raw array.
      comments.set(Array.isArray(json) ? json : (json?.data ?? []))
      if (!Array.isArray(json)) {
        commentsPage.set(Math.max(1, Number(json?.current_page ?? page)))
        commentsLastPage.set(Math.max(1, Number(json?.last_page ?? 1)))
        commentsTotal.set(Number(json?.total ?? 0))
      }
    }
    catch (err) {
      console.error('[comments] fetch failed:', err)
    }
    finally {
      commentsLoaded.set(true)
    }
  }

  onMount(() => { loadComments() })

  // Page buttons are plain objects with their variant class precomputed: an
  // x-class inside a :for must not carry signal call-syntax.
  function buildCommentPages(current: number, last: number) {
    if (last <= 1) return []
    const cur = Math.max(1, Math.min(current, last))
    const out: any[] = []
    const page = (n: number) => out.push({ n, label: String(n), gap: false, active: n === cur })
    const gap = () => out.push({ n: 0, label: '…', gap: true, active: false })
    const lo = Math.max(2, cur - 1)
    const hi = Math.min(last - 1, cur + 1)
    page(1)
    if (lo > 2) gap()
    for (let n = lo; n <= hi; n++) page(n)
    if (hi < last - 1) gap()
    page(last)
    return out
  }
  const commentPages = derived(() => buildCommentPages(commentsPage(), commentsLastPage()).map(it => ({
    ...it,
    cls: it.gap
      ? 'text-gray-400 border-transparent pointer-events-none'
      : (it.active ? 'bg-blue-600 text-white border-blue-600' : 'text-gray-700 border-gray-300 hover:bg-gray-50'),
  })))
  const showCommentPager = derived<boolean>(() => commentsLastPage() > 1)
  const prevCls = derived<string>(() => (commentsPage() <= 1 ? 'text-gray-300 border-gray-200 pointer-events-none' : 'text-gray-700 border-gray-300 hover:bg-gray-50'))
  const nextCls = derived<string>(() => (commentsPage() >= commentsLastPage() ? 'text-gray-300 border-gray-200 pointer-events-none' : 'text-gray-700 border-gray-300 hover:bg-gray-50'))

  function goToCommentPage(n: number): void {
    if (n < 1 || n > commentsLastPage() || n === commentsPage()) return
    void loadComments(n)
  }

  async function submitComment(): Promise<void> {
    if (commentSubmitting()) return
    commentFieldError.set(false)
    const body = commentDraft().trim()
    if (body.length < 5) {
      commentFieldError.set(true)
      commentError.set('Comment must be at least 5 characters.')
      toast.error('Comment', 'Comment must be at least 5 characters.')
      document.getElementById('comment-body')?.focus()
      return
    }
    commentSubmitting.set(true)
    commentError.set('')
    try {
      const res = await authStore.authFetch(`/api/reviews/${reviewIdForComments}/comments`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ body, anonymized: commentAnon() }),
      })
      const data = await res.json().catch(() => ({})) as { ok?: boolean, error?: string, comment?: any }
      if (!res.ok || !data.ok) {
        const message = data.error || 'Could not post comment.'
        commentFieldError.set(true)
        commentError.set(message)
        toast.error('Comment', message)
        return
      }
      commentDraft.set('')
      commentAnon.set(false)
      toast.success('Comment posted', 'Your comment was added.')
      // Refetch so we see the canonical server-side ordering + the new
      // comment's gated-author shape (in case the client guessed wrong on
      // what the public sees). Comments are oldest-first, so a new one lands
      // on the LAST page — computed from the count we already have rather
      // than spending a round trip to discover it. Refetching page 1 would
      // hide the comment the person just wrote.
      await loadComments(Math.max(1, Math.ceil((commentsTotal() + 1) / PER_PAGE)))
    }
    catch (err) {
      const message = err instanceof Error ? err.message : 'Network error'
      commentError.set(message)
      toast.error('Comment', message)
    }
    finally {
      commentSubmitting.set(false)
    }
  }

  async function deleteComment(commentId: number): Promise<void> {
    if (typeof window === 'undefined') return
    if (deletingId()) return
    const ok = await confirmStore.ask({ title: 'Delete comment', message: 'Delete this comment? This cannot be undone.', confirmLabel: 'Delete', danger: true })
    if (!ok) return
    deletingId.set(commentId)
    try {
      const res = await authStore.authFetch(`/api/me/comments/${commentId}`, { method: 'DELETE' })
      if (!res.ok) return
      comments.set(comments().filter(c => c.id !== commentId))
      toast.success('Comment deleted', 'Your comment was removed.')
      // Keep the pager honest. Without this the total stays one too high,
      // which both leaves a page button pointing at nothing and throws off
      // the "which page did my new comment land on" sum after the next post.
      const remaining = Math.max(0, commentsTotal() - 1)
      commentsTotal.set(remaining)
      const lastPage = Math.max(1, Math.ceil(remaining / PER_PAGE))
      commentsLastPage.set(lastPage)
      // Deleting the only comment on the final page strands the reader on an
      // empty one; step back and refetch.
      if (commentsPage() > lastPage)
        await loadComments(lastPage)
    }
    catch (err) {
      console.error('[comments] delete failed:', err)
    }
    finally {
      deletingId.set(null)
    }
  }

  function formatDate(dateStr: string | null | undefined): string {
    if (!dateStr) return ''
    const d = new Date(dateStr)
    if (Number.isNaN(d.getTime())) return ''
    const diffMs = Date.now() - d.getTime()
    const minutes = Math.floor(diffMs / 60000)
    if (minutes < 1) return 'just now'
    if (minutes < 60) return `${minutes}m ago`
    const hours = Math.floor(minutes / 60)
    if (hours < 24) return `${hours}h ago`
    const days = Math.floor(hours / 24)
    if (days < 7) return `${days}d ago`
    return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })
  }

  // Is the comment author the viewer? Drives the per-row Delete affordance.
  //
  // Reads the server's explicit is_mine rather than comparing author.id. The
  // author payload is public-safe: publicReviewerFor nulls the id on anonymous
  // comments so the avatar can't link to /user/:id. Comparing ids therefore
  // failed for exactly the rows the viewer owned anonymously — an anonymous
  // commenter could never delete their own comment.
  function isMyComment(c: CommentRow): boolean {
    return !!c.is_mine
  }

  // Initial for the avatar circle when the comment author has no
  // image. Same convention as the bell-dropdown / user-menu avatar.
  function initialFor(name: string | null | undefined): string {
    if (!name) return '?'
    const raw = name.replace(/^(hon\.|judge|mr\.|mrs\.|ms\.|dr\.)\s+/i, '').trim()
    return raw.charAt(0).toUpperCase() || '?'
  }

  const isAuthenticated = authStore.isAuthenticated

  // The review's own author can't comment on their own review (same
  // self-interaction rule as the self-like gate in ArticleView). Read
  // the row from the shared reviews store — the article page already
  // fetched it via reviewsStore.fetchById(), so reviewsStore.current()
  // is the review this thread hangs off of. No @include scope
  // forwarding needed (which stx doesn't reliably support anyway).
  //
  // Uses the row's is_mine flag, NOT user_id: ShowReviewAction strips user_id
  // from its response as a de-anonymisation guard and exposes is_mine instead,
  // so `Number(undefined) === Number(me.id)` was NaN === n — permanently false.
  // The review's own author was therefore shown the composer, and only found
  // out their comment wasn't welcome when the submit came back 403.
  const isReviewAuthor = derived<boolean>(() => {
    const row = reviewsStore.current()
    return !!row && !!(row as any).is_mine
  })
  // Composer is for signed-in NON-authors only.
  const canCompose = derived<boolean>(() => isAuthenticated() && !isReviewAuthor())
</script>

<section class="mt-12 pt-8 border-gray-200 border-t">
  <header class="flex items-end justify-between">
    <h2 class="font-semibold text-base text-gray-900">{{ `Comments (${comments().length})` }}</h2>
  </header>

  {{-- Composer slot — one if/else-if/else chain (mutually exclusive,
      one effect drives it, so branches can't transiently co-render):
        - signed-in non-author  → the composer
        - signed-in author       → muted "can't comment on your own"
        - anonymous              → sign-in CTA
      The author can't comment on their own review (mirrors the
      self-like gate in ArticleView). --}}
  <div :if="canCompose()" class="mt-5 p-4 bg-white border border-gray-200 rounded-lg">
    <textarea
      id="comment-body"
      x-model="commentDraft"
      rows="3"
      aria-label="Add a comment"
      placeholder="Add a comment — context, clarification, or a respectful pushback."
      @input="commentFieldError.set(false)"
      @focus="commentFieldError.set(false)"
      class="block px-3 py-2 w-full text-gray-900 sm:text-sm bg-white border rounded-md focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
      x-class="commentFieldError() ? 'border-red-500 ring-1 ring-red-300' : 'border-gray-300'"
    ></textarea>

    <div
      role="alert"
      class="mt-2 px-3 py-2 text-red-800 text-xs bg-red-50 border border-red-200 rounded-md"
      x-class="commentError() ? '' : 'hidden'">{{ commentError() }}</div>

    <div class="flex flex-wrap gap-2 items-center justify-between mt-3">
      <label class="flex gap-2 items-center text-gray-600 text-xs cursor-pointer">
        <input type="checkbox" x-model="commentAnon" class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-2 focus:ring-blue-600">
        Post anonymously
      </label>
      <button
        type="button"
        @click="submitComment()"
        x-disabled="commentSubmitting"
        class="inline-flex items-center justify-center px-4 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-md disabled:opacity-50"
      >
        <svg :if="commentSubmitting()" class="-ml-0.5 mr-2 h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25"></circle><path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg>
        <span>{{ commentSubmitting() ? 'Posting…' : 'Post comment' }}</span>
      </button>
    </div>
  </div>

  <div :else-if="isReviewAuthor()" class="mt-5 p-4 text-center bg-gray-50 border border-gray-200 rounded-lg">
    <p class="text-gray-500 text-sm">You can't comment on your own review.</p>
  </div>

  <div :else class="mt-5 p-5 text-center bg-gray-50 border border-gray-200 rounded-lg">
    <p class="text-gray-600 text-sm">
      <StxLink to="/login" class="font-semibold text-gray-900 underline-offset-2 hover:underline">Sign in</StxLink>
      to leave a comment.
    </p>
  </div>

  {{-- Three mutually-exclusive states wired as one if/else-if/else chain
      (stx#1734). One effect drives mutual exclusion, branches can't
      transiently both render in a tick. --}}
  <ul :if="!commentsLoaded()" class="mt-6 space-y-4">
    <li :for="i in [1, 2]" class="p-4 bg-white border border-gray-100 rounded-lg animate-pulse">
      <div class="flex gap-3 items-center">
        <div class="h-8 w-8 bg-gray-200 rounded-full"></div>
        <div class="flex-1 space-y-1.5">
          <div class="h-3 w-24 bg-gray-200 rounded"></div>
          <div class="h-2 w-16 bg-gray-100 rounded"></div>
        </div>
      </div>
      <div class="mt-3 space-y-1.5">
        <div class="h-3 w-full bg-gray-200 rounded"></div>
        <div class="h-3 w-4/5 bg-gray-200 rounded"></div>
      </div>
    </li>
  </ul>

  <div :else-if="comments().length === 0" class="mt-6 p-8 text-center text-gray-500 text-sm bg-gray-50 border border-dashed border-gray-200 rounded-lg">
    No comments yet. Be the first to add context.
  </div>

  <ul :else class="mt-6 space-y-4">
    <li :for="c in comments" class="p-4 bg-white border border-gray-100 rounded-lg">
      <div class="flex gap-3 items-start">
        <span class="inline-flex flex-none items-center justify-center h-8 w-8 font-semibold text-blue-700 text-xs bg-blue-50 ring-1 ring-blue-200/60 rounded-full">{{ initialFor(c.author && c.author.name) }}</span>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap gap-x-2 gap-y-0.5 items-baseline">
            {{-- Linked when we have a real reviewer id (non-anonymous); plain text otherwise. --}}
            <StxLink :if="c.author && c.author.id" x-to="`/user/${c.author.id}`" class="font-medium text-gray-900 text-sm underline-offset-2 hover:underline">{{ c.author.name }}</StxLink>
            <span :if="!(c.author && c.author.id)" class="font-medium text-gray-700 text-sm">{{ c.author && c.author.name || 'Anonymous reviewer' }}</span>
            <span class="text-gray-400 text-xs">{{ formatDate(c.created_at) }}</span>
          </div>
          <p class="mt-1 leading-relaxed text-gray-700 text-sm">{{ c.body }}</p>
          <button
            :if="isMyComment(c)"
            type="button"
            @click="deleteComment(c.id)"
            class="mt-2 text-red-600 text-xs underline-offset-2 hover:text-red-700 hover:underline"
          >Delete</button>
        </div>
      </div>
    </li>
  </ul>

  {{-- Numbered pagination. Hidden until there is more than one page, which
      is false at first render, so `:show` + static display:none rather than
      an x-class toggle that the pre-rendered page would paint
      (stx-standards 7.3, gate check 19). The numbered buttons read
      item.cls, precomputed in commentPages(), so the :for carries no signal
      call-syntax; Prev/Next sit outside the loop where call-syntax is
      fine. --}}
  <div :show="showCommentPager" style="display:none" class="flex flex-col gap-3 items-center mt-8">
    <nav class="flex flex-wrap gap-1.5 items-center justify-center" aria-label="Comment pagination">
      <button
        type="button"
        @click="goToCommentPage(commentsPage() - 1)"
        class="px-2.5 py-1.5 font-medium text-sm border rounded-md transition-colors"
        x-class="prevCls()"
        aria-label="Previous page"
      >Prev</button>
      <button
        :for="item in commentPages()"
        type="button"
        @click="goToCommentPage(item.n)"
        class="px-2.5 py-1.5 min-w-[2rem] font-medium tabular-nums text-sm border rounded-md transition-colors"
        x-class="item.cls"
      >{{ item.label }}</button>
      <button
        type="button"
        @click="goToCommentPage(commentsPage() + 1)"
        class="px-2.5 py-1.5 font-medium text-sm border rounded-md transition-colors"
        x-class="nextCls()"
        aria-label="Next page"
      >Next</button>
    </nav>
    <p class="text-gray-500 text-xs">{{ 'Page ' + commentsPage() + ' of ' + commentsLastPage() + ' · ' + commentsTotal() + ' comments' }}</p>
  </div>
</section>
