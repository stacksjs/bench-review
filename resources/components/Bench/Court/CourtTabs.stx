<script client>
  // Court-house detail tab bar. Reads the court id from URL pathname
  // so each leaf view (/court-houses/:id/{profile,reviews,bench}) can
  // drop in this include without duplicating logic.

  function resolveCourtId(): number {
    if (typeof window === 'undefined') return 0
    // stx-standards 9.10: route params come from useRoute(), never from
    // re-parsing the URL. useRoute().params reads a signal that the runtime
    // primes from the id the build injects into <head> -- byte 520 of
    // court-houses/1/profile.html, well before the runtime loads -- so it is
    // already populated by the time this runs on a hard reload. useRoute is
    // auto-imported; do not hand-import it.
    const fromRoute = Number(useRoute().params.id)
    if (Number.isFinite(fromRoute) && fromRoute > 0) return fromRoute
    // Shell fallback, and the reason this is not a bare useRoute() call. When
    // one built page serves many ids the injected param is the literal
    // '_shell' -- that is how the judge tabs work today, and how courthouse
    // tabs will work once #83 lands -- and the real id exists only in the
    // path. Keeping this here means #83 does not have to reopen these files.
    const m = window.location.pathname.match(/^\/court-houses\/(\d+)/)
    return m ? Number(m[1]) : 0
  }

  function resolveActiveTab(): 'profile' | 'reviews' | 'bench' {
    if (typeof window === 'undefined') return 'profile'
    const p = window.location.pathname
    if (p.includes('/reviews')) return 'reviews'
    if (p.includes('/bench')) return 'bench'
    return 'profile'
  }

  const courtTabsId = state<number>(resolveCourtId())
  const courtActiveTab = state<'profile' | 'reviews' | 'bench'>(resolveActiveTab())

  // Hrefs as DERIVED STRINGS, not template literals inside x-to.
  //
  // Interpolating the id straight into x-to evaluates once, at build time,
  // while courtTabsId is still its initial 0 -- so every built courthouse page
  // shipped href="/court-houses/undefined/profile" and all three tabs led
  // nowhere. Verified in the artifact: dist/court-houses/1/profile.html
  // contained only the three 'undefined' hrefs, never a real id.
  //
  // A derived returning a concatenated string re-evaluates after onMount sets
  // the real id. Same fix, same reason, as Bench/Judge/JudgeTabs, which hit
  // this first. Concatenation rather than interpolation on purpose: a backtick
  // in a client script is its own hazard.
  const courtProfileHref = derived<string>(() => '/court-houses/' + courtTabsId() + '/profile')
  const courtBenchHref = derived<string>(() => '/court-houses/' + courtTabsId() + '/bench')
  const courtReviewsHref = derived<string>(() => '/court-houses/' + courtTabsId() + '/reviews')

  onMount(() => {
    courtTabsId.set(resolveCourtId())
    courtActiveTab.set(resolveActiveTab())
  })
</script>

<div class="mx-auto pt-8 px-4 sm:px-6 lg:px-8 max-w-7xl">
  <div class="hidden sm:block">
    <nav class="flex -mb-px space-x-8 border-b border-gray-200" aria-label="Tabs">
      <StxLink
        x-to="courtProfileHref"
        class="px-1 py-4 font-medium text-sm whitespace-nowrap border-b-2 transition-colors"
        x-class="courtActiveTab === 'profile' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'"
      >
        Profile
      </StxLink>
      <StxLink
        x-to="courtBenchHref"
        class="px-1 py-4 font-medium text-sm whitespace-nowrap border-b-2 transition-colors"
        x-class="courtActiveTab === 'bench' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'"
      >
        Judges on the Bench
      </StxLink>
      <StxLink
        x-to="courtReviewsHref"
        class="px-1 py-4 font-medium text-sm whitespace-nowrap border-b-2 transition-colors"
        x-class="courtActiveTab === 'reviews' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'"
      >
        Reviews
      </StxLink>
    </nav>
  </div>
</div>
