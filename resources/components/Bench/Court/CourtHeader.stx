<script client>
  // Court-house detail header. Resolves the court id from useRoute(), with
  // a pathname fallback for shell-served pages, and looks it up against
  // judgesStore's courtHouses cache.

  function resolveCourtId(): number {
    if (typeof window === 'undefined') return 0
    // stx-standards 9.10: route params come from useRoute(), never from
    // re-parsing the URL. useRoute().params reads a signal that the runtime
    // primes from the id the build injects into <head> -- byte 520 of
    // court-houses/1/profile.html, well before the runtime loads -- so it is
    // already populated by the time this runs on a hard reload. useRoute is
    // auto-imported; do not hand-import it.
    const fromRoute = Number(useRoute().params.id)
    if (Number.isFinite(fromRoute) && fromRoute > 0) return fromRoute
    // Shell fallback, and the reason this is not a bare useRoute() call. When
    // one built page serves many ids the injected param is the literal
    // '_shell' -- that is how the judge tabs work today, and how courthouse
    // tabs will work once #83 lands -- and the real id exists only in the
    // path. Keeping this here means #83 does not have to reopen these files.
    const m = window.location.pathname.match(/^\/court-houses\/(\d+)/)
    return m ? Number(m[1]) : 0
  }

  const courtHeaderId = state<number>(resolveCourtId())
  const courtsStore = useStore('judges')

  // Fetch in BOTH top-level (hydration) and onMount (SPA nav). See
  // feedback_stx_toplevel_skipped_on_spa_nav.
  let courtHasFetched = false
  function fetchCourtsOnce(): void {
    if (courtHasFetched) return
    courtHasFetched = true
    if (courtsStore.courtHouses().length === 0)
      courtsStore.fetchCourtHouses()
    if (courtsStore.judges().length === 0)
      courtsStore.fetchJudges()
  }
  fetchCourtsOnce()
  onMount(() => {
    courtHeaderId.set(resolveCourtId())
    fetchCourtsOnce()
  })

  const currentCourt = derived(() => {
    const id = courtHeaderId()
    if (!id) return null
    return courtsStore.courtHouses().find((c: any) => Number(c.id) === id) || null
  })

  // No useSeoMeta here any more.
  //
  // This used to set a generic baseline -- ogTitle 'Courthouse profile — Bench
  // Review' and friends -- with a comment saying per-courthouse interpolation
  // needed server-side data resolution as a follow-up. That follow-up exists
  // now: entitySeo resolves each courthouse at build time and injects the real
  // title, description, og and twitter tags into court-houses/<id>.html, which
  // is the page the sitemap advertises.
  //
  // So this call had stopped being a baseline and become an override, replacing
  // the real per-courthouse values with generic ones the moment the component
  // hydrated. Verified: the built page carries og:title 'Court of Appeals for
  // the Sixth Circuit in Cincinnati | Bench Review', while document.title in
  // the browser read 'Courthouse profile — Bench Review'. Crawlers that run JS
  // saw the generic one.

  const courtName = derived<string>(() => (currentCourt() as any)?.name || '')
  const courtCity = derived<string>(() => (currentCourt() as any)?.city || '')
  const courtState = derived<string>(() => (currentCourt() as any)?.state || '')
  // The previous fallback was an Unsplash URL carrying `fit=facearea&facepad=2`
  // — a portrait crop, used as the picture of a COURTHOUSE, and the very same
  // URL that Judge/ProfileHeader.stx used for a missing judge photo. A building
  // and a person rendered as the same stock face.
  const courtImage = derived<string>(() => {
    const c: any = currentCourt()
    return (c && (c.image || c.image_url)) || '/images/placeholders/court.svg'
  })

  // Judges on this bench — handy for the header's secondary stat and
  // the bench tab. Filter against the judges cache by court id.
  const benchJudges = derived(() => {
    const id = courtHeaderId()
    if (!id) return []
    return courtsStore.judges().filter((j: any) => Number(j.court?.id ?? j.court_id) === id)
  })
</script>

<header class="relative pt-16 isolate">
  <div class="absolute inset-0 overflow-hidden -z-10" aria-hidden="true">
    <div class="absolute bottom-0 inset-x-0 h-px bg-gray-900/5"></div>
  </div>

  <div class="mx-auto px-4 py-10 sm:px-6 lg:px-8 max-w-7xl">
    <div class="flex gap-x-6 items-center">
      <img src="/images/placeholders/court.svg" alt="Courthouse" x-src="courtImage" x-alt="courtName" class="object-cover flex-none h-16 w-16 ring-1 ring-gray-900/10 rounded-lg">
      <div>
        <div class="text-gray-500 text-sm/6">Courthouse <span class="text-gray-700" :text="`#${courtHeaderId}`"></span></div>
        <h1 class="mt-1 font-semibold text-base text-gray-900" :text="courtName"></h1>
        <p class="mt-0.5 text-gray-500 text-sm" :text="`${courtCity}${courtCity && courtState ? ', ' : ''}${courtState}`"></p>
      </div>
    </div>
  </div>
</header>
