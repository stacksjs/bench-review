<script client>
  const showCopiedFeedback = state<boolean>(false)
  const menuOpen = state<boolean>(false)

  // Resolve the judge id — same useRoute()-first pattern as ArticleView,
  // with the pathname fallback for the shell-served tabs where the
  // injected param is the literal '_shell' (stx-standards 9.10).
  function resolveJudgeId(): number {
    if (typeof window === 'undefined') return 0
    // stx-standards 9.10: route params come from useRoute(), never from
    // window.stx._rp and never by re-parsing the URL. useRoute().params reads
    // a signal the runtime primes from the id the build injects into <head>,
    // ahead of the runtime itself, so it is populated on a hard reload too —
    // which is what the older note about _rp being unset was working around.
    // useRoute is auto-imported; do not hand-import it.
    const fromRouter = Number(useRoute().params.id)
    if (Number.isFinite(fromRouter) && fromRouter > 0) return fromRouter
    const m = window.location.pathname.match(/^\/judges\/(\d+)/)
    return m ? Number(m[1]) : 0
  }

  const judgeId = state<number>(resolveJudgeId())

  const authStore = useStore('auth')
  const followsStore = useStore('follows')
  const judgesStore = useStore('judges')

  // Pull the followed-ids and the judges directory once per mount. Both
  // are noop-cheap when already loaded (the stores dedupe internally).
  // Top-level + onMount, see feedback_stx_toplevel_skipped_on_spa_nav.
  let hasFetched = false
  function fetchOnce(): void {
    if (hasFetched) return
    hasFetched = true
    // Called, not read. isAuthenticated is a derived<boolean>, i.e. a function,
    // and stx's auto-unwrap proxy only applies inside template expressions —
    // in plain <script client> JS the store hands back the raw signal, so a
    // bare read is a function reference and always truthy.
    if (authStore.isAuthenticated())
      followsStore.fetchFollows()
    if (judgesStore.judges().length === 0)
      judgesStore.fetchJudges()
  }
  fetchOnce()
  onMount(() => {
    const resolved = resolveJudgeId()
    // Non-numeric / missing id (e.g. someone hits /judges/<garbage> — a
    // segment the dynamic [id] route catches but that isn't a real judge
    // id, and isn't a named static route like /judges/signup). Send them
    // to the directory instead of rendering a stuck "Judge #0".
    if (resolved <= 0) {
      navigate('/judges', true)
      return
    }
    // No bare-/judges/{id} redirect any more. It existed because
    // views/judges/[id].stx ended in an @slot('content') that nothing on this
    // route filled, so the page rendered empty without one — and it made the
    // canonical URL in the sitemap a client-side bounce to a shared shell
    // (#64). That view now renders the judge itself, so the canonical page
    // stands on its own and this component is just a header again.
    judgeId.set(resolved)
    fetchOnce()
  })

  // View-model: the current judge row (resolved against the store by
  // id). Falls back to placeholder text while loading so the header
  // doesn't show literal "undefined".
  const currentJudge = derived(() => {
    const id = judgeId()
    if (!id) return null
    return judgesStore.judges().find((j: any) => Number(j.id) === id) || null
  })

  // No useSeoMeta here, deliberately. It used to set a generic
  // "Judge profile — Bench Review" title/description/OG set as a
  // per-page-type baseline, and because this component mounts on the
  // canonical /judges/:id page it overwrote, at hydration, the per-judge
  // head that app/Helpers/entitySeo.ts injects at build time — the exact
  // regression fixed for CourtHeader in 83d0b6da. The static HTML kept the
  // right title, so crawlers were unaffected, but the browser tab, history
  // entry and share sheet all read the generic one.
  //
  // entitySeo is the source for these pages; the shared tab shells get their
  // baseline from the shell views themselves.

  const judgeName = derived<string>(() => currentJudge()?.name || '')
  // Local silhouette rather than the stock Unsplash face this used to fall back
  // to. A judge profile attributing a random person's photograph to a named
  // sitting judge is the worst place in the app to get this wrong.
  const judgeImage = derived<string>(() => {
    const j: any = currentJudge()
    return (j && (j.image_url || j.photo)) || '/images/avatars/default-user.svg'
  })

  const isFollowing = derived<boolean>(() => followsStore.isFollowing(judgeId()))

  // Gate the claim prompt on the name having loaded, so it never renders
  // "Are you ?" while the fetch is in flight.
  const hasJudgeName = derived<boolean>(() => !!judgeName())

  // "Report incorrect information" (bench-review#50). The FAQ has promised a
  // correction link on every judge profile since launch and it existed on no
  // component, so the one channel the site advertises for fixing a record
  // about a named, sitting judge went nowhere.
  const correctionOpen = state<boolean>(false)
  const correctionDetails = state<string>('')
  const correctionSource = state<string>('')
  const correctionEmail = state<string>('')
  const correctionSending = state<boolean>(false)
  const correctionDone = state<boolean>(false)
  const correctionError = state<string>('')
  const MIN_CORRECTION = 15

  const correctionTooShort = derived<boolean>(() => correctionDetails().trim().length < MIN_CORRECTION)
  const correctionBlocked = derived<boolean>(() => correctionSending() || correctionTooShort())

  function toggleCorrection(): void {
    correctionOpen.set(!correctionOpen())
    correctionError.set('')
  }

  async function sendCorrection(): Promise<void> {
    if (correctionBlocked())
      return
    correctionSending.set(true)
    correctionError.set('')
    try {
      const ok = await judgesStore.reportJudgeCorrection(judgeId(), {
        details: correctionDetails().trim(),
        sourceUrl: correctionSource().trim(),
        submitterEmail: correctionEmail().trim(),
      })
      if (ok === true) {
        correctionDone.set(true)
        correctionOpen.set(false)
        correctionDetails.set('')
        correctionSource.set('')
        correctionEmail.set('')
      }
      else {
        correctionError.set(typeof ok === 'string' ? ok : 'Could not send that — please try again.')
      }
    }
    finally {
      correctionSending.set(false)
    }
  }
  const followPending = derived<boolean>(() => followsStore.isPending(judgeId()))

  async function toggleFollow(): Promise<void> {
    const id = judgeId()
    if (!id) return
    // Same bare-read bug as fetchOnce above, but this one was user-visible in
    // the other direction: `!fn` is always FALSE, so an anonymous visitor
    // clicking Follow never got the login redirect. The call fell through to
    // followsStore.toggle(), which fails unauthenticated — the button appeared
    // to do nothing at all.
    if (!authStore.isAuthenticated()) {
      navigate(`/login?next=${encodeURIComponent(window.location.pathname)}`, true)
      return
    }
    await followsStore.toggle(id)
  }

  function closeMoreMenu(event: FocusEvent): void {
    const wrap = event.currentTarget as HTMLElement | null
    const next = event.relatedTarget as Node | null
    if (wrap && next && wrap.contains(next))
      return
    menuOpen.set(false)
  }

  async function shareProfile(): Promise<void> {
    const url = window.location.href
    const title = currentJudge()?.name ? `${currentJudge().name} — Bench Review` : 'Judge Profile'
    if (navigator.share) {
      try {
        await navigator.share({ title, url })
      }
      catch (err) {
        console.error('Error sharing:', err)
      }
    }
    else {
      navigator.clipboard.writeText(url)
      showCopiedFeedback.set(true)
      setTimeout(() => { showCopiedFeedback.set(false) }, 2000)
    }
  }
</script>

<header class="relative pt-16 isolate">
    <div class="absolute inset-0 overflow-hidden -z-10" aria-hidden="true">
      <div class="absolute bottom-0 inset-x-0 h-px bg-gray-900/5"></div>
    </div>

  <div class="mx-auto px-4 py-10 sm:px-6 lg:px-8 max-w-7xl">
    <div class="flex gap-x-8 items-center justify-between mx-auto lg:mx-0 max-w-2xl lg:max-w-none">
      <div class="flex gap-x-6 items-center">
        <img src="/images/avatars/default-user.svg" alt="Judge" x-src="judgeImage" x-alt="judgeName" class="object-cover flex-none size-16 ring-1 ring-gray-900/10 rounded-full grayscale filter">
        <h1>
          <div class="text-gray-500 text-sm/6">Judge <span class="text-gray-700">{{ `#${judgeId}` }}</span></div>
          <div class="mt-1 font-semibold text-base text-gray-900">{{ judgeName }}</div>
        </h1>
      </div>
      <div class="flex gap-x-4 items-center sm:gap-x-6">
        <button
          type="button"
          class="hidden sm:block font-semibold text-gray-900 text-sm/6"
          @click="shareProfile()"
        >
          <span :if="!showCopiedFeedback">Share Profile</span>
          <span :if="showCopiedFeedback">Copied!</span>
        </button>
        <StxLink x-to="`/review/${judgeId}`" class="hidden sm:block font-semibold text-gray-900 text-sm/6">Write Review</StxLink>
        <button
          type="button"
          @click="toggleFollow()"
          x-disabled="followPending"
          class="px-3 py-2 font-semibold text-sm rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 shadow-sm transition-colors"
          x-class="[
            isFollowing
              ? 'bg-white text-gray-900 ring-1 ring-gray-300 hover:bg-gray-50 focus-visible:outline-gray-300'
              : 'bg-blue-600 text-white hover:bg-blue-700 focus-visible:outline-blue-600'
          ]"
        >{{ followPending ? '…' : (isFollowing ? 'Following' : 'Follow') }}</button>

        {{-- @focusout, not @click.away: `away` is not an stx event modifier
            (the binder knows self/ctrl/alt/shift/meta/prevent/stop plus key
            names), so it was silently dropped and the handler registered as an
            ordinary click — meaning the menu closed only when clicked INSIDE,
            and never on an outside click. focusout bubbles, unlike blur. --}}
        <div class="sm:hidden relative" @focusout="closeMoreMenu($event)">
          {{-- aria-expanded has to TRACK the state, not state it once. It was
              a static "false", so the panel opened and a screen reader kept
              being told it was collapsed. aria-haspopup is gone with the
              menu roles below: the panel is a disclosure, not an ARIA menu,
              and haspopup="true" means specifically "menu". --}}
          <button type="button" class="block -m-3 p-3" @click="menuOpen.set(!menuOpen())" id="more-menu-button" aria-expanded="false" x-aria-expanded="menuOpen() ? 'true' : 'false'">
            <span class="sr-only">More</span>
            <Icon name="ellipsis-vertical" size="20" class="text-gray-500" />
          </button>

          {{-- A disclosure, not a menu. This carried role="menu" with
              role="menuitem" children and tabindex="-1" on all three, which
              is the ARIA menu pattern — and that pattern promises roving
              focus driven by arrow keys, which nothing here implements. The
              result was a panel no keyboard user could reach at all: the
              only focusable thing was the trigger, and opening it led
              nowhere. Two ordinary controls in normal tab order is what this
              actually is, and the trigger already carries aria-expanded.
              Same reasoning as MyReviewsView's filters, which are toggle
              buttons rather than tabs (bench-review#58).

              focus:outline-none is gone too: nothing ever focused this
              container programmatically, so it was suppressing an indicator
              that could only have helped. --}}
          <div :if="menuOpen" class="absolute right-0 z-10 mt-0.5 py-2 w-32 bg-white ring-1 ring-gray-900/5 rounded-md shadow-lg origin-top-right" aria-labelledby="more-menu-button">
            <button type="button" class="block px-3 py-1 w-full text-gray-900 text-left text-sm/6 focus-visible:bg-gray-50 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-[-2px]" id="more-menu-item-0" @click="shareProfile()">Share Profile</button>
            <StxLink to="/review" class="block px-3 py-1 text-gray-900 text-sm/6 focus-visible:bg-gray-50 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-[-2px]" id="more-menu-item-1">Write Review</StxLink>
          </div>
        </div>
      </div>
    </div>

    {{-- Claim prompt. The footer and /guidelines already link to
        /judges/signup, but the page a judge actually lands on -- their own
        profile, which is where a search for their name sends them -- did not,
        so the funnel's one high-intent entry point was missing
        (bench-review#57).

        It pairs with the publish fan-out in 44c589ce: that gives a verified
        claimant a notification when a review of them is published, and this
        is how they find out claiming is possible in the first place.

        Deliberately quiet -- a line of text under the header, not a button
        competing with Follow. It is addressed to one specific person out of
        everyone who loads the page.

        `:show`, not `:if`: the name arrives with the fetch, so this starts
        false at first render, which is exactly the case bindIf drops and
        never brings back (stx-standards 7.3, gate check 19). --}}
    <p
      :show="hasJudgeName"
      style="display:none"
      class="mt-6 text-gray-500 text-sm"
    >
      Are you {{ judgeName }}?
      <StxLink to="/judges/signup" class="font-medium text-blue-700 underline underline-offset-2 hover:text-blue-900">Claim this profile</StxLink>
      to respond to reviews.
    </p>

    {{-- Correction channel. Quiet by design — it sits under the claim line as
        a text link, not a button, because it is addressed to the small number
        of readers who spot an error rather than to everyone. --}}
    <p class="mt-2 text-gray-500 text-sm" :show="hasJudgeName" style="display:none">
      Something wrong on this page?
      <button
        type="button"
        @click="toggleCorrection()"
        class="font-medium text-blue-700 underline underline-offset-2 hover:text-blue-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2"
      >Report incorrect information</button>
    </p>

    <p class="mt-2 text-emerald-700 text-sm" :show="correctionDone" style="display:none">
      Thanks — a moderator will check this against the record.
    </p>

    <div class="mt-3 p-4 max-w-xl bg-white border border-gray-200 rounded-lg" :show="correctionOpen" style="display:none">
      <label for="judge-correction-details" class="block font-semibold text-gray-900 text-sm">What is incorrect?</label>
      <p class="mt-0.5 text-gray-500 text-xs">Tell us what the page gets wrong and what it should say.</p>
      <textarea
        id="judge-correction-details"
        x-model="correctionDetails"
        rows="4"
        class="block mt-2 px-3 py-2 w-full text-gray-900 sm:text-sm bg-white border border-gray-300 rounded-md focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
      ></textarea>

      <label for="judge-correction-source" class="block mt-3 font-semibold text-gray-900 text-sm">Source <span class="font-normal text-gray-400">(optional)</span></label>
      <input
        id="judge-correction-source"
        x-model="correctionSource"
        type="url"
        placeholder="https://"
        class="block mt-1 px-3 py-2 w-full text-gray-900 sm:text-sm bg-white border border-gray-300 rounded-md focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
      >

      <label for="judge-correction-email" class="block mt-3 font-semibold text-gray-900 text-sm">Your email <span class="font-normal text-gray-400">(optional)</span></label>
      <p class="mt-0.5 text-gray-500 text-xs">Only so we can follow up if we need to.</p>
      <input
        id="judge-correction-email"
        x-model="correctionEmail"
        type="email"
        class="block mt-1 px-3 py-2 w-full text-gray-900 sm:text-sm bg-white border border-gray-300 rounded-md focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
      >

      <p class="mt-2 text-red-700 text-xs" :show="correctionError" style="display:none">{{ correctionError() }}</p>

      <div class="flex gap-x-2 mt-3">
        <button
          type="button"
          @click="sendCorrection()"
          x-disabled="correctionBlocked"
          class="px-3 py-1.5 font-semibold text-white text-xs bg-blue-600 hover:bg-blue-700 rounded disabled:opacity-50 disabled:cursor-not-allowed"
        >{{ correctionSending() ? 'Sending…' : 'Send report' }}</button>
        <button
          type="button"
          @click="toggleCorrection()"
          class="px-3 py-1.5 font-medium text-gray-700 text-xs bg-white hover:bg-gray-50 border border-gray-300 rounded"
        >Cancel</button>
      </div>
    </div>
  </div>
</header>
