<script client>
  // Judge professional background.
  //
  // ## What this replaced
  //
  // Static markup with no bindings, rendered identically on the Profile tab of
  // all 2,740 real named federal judges: "J.D., Stanford Law School",
  // "Bar Admission: California, 2005", "Senior Partner, Johnson & Associates",
  // plus a "Recent Cases" table asserting outcomes ("State v. Johnson — 2023 —
  // Guilty"). Every judge claimed the same degree, firm and case outcomes.
  //
  // That was false biographical and professional history about identifiable
  // people — and an asserted criminal conviction — on a page built to host
  // public criticism of them. Profile is also the DEFAULT tab (JudgeTabs falls
  // back to 'profile'), so it was the most-seen surface in the app.
  //
  // ## What it shows now
  //
  // Real education from CourtListener's people-db-educations + people-db-schools
  // export, ingested by scripts/ingest-courtlistener.ts into judges.education
  // and served by /api/judges/{id}/education. About 1,324 of the 2,730 sitting
  // judges have records; the rest get the empty state rather than a guess.
  //
  // Bar admission, firm history and case outcomes are NOT coming back. We have
  // no source for them, and "Outcome: Guilty" beside a judge's name is not a
  // claim this site should make even with one.
  //
  // Mirrors Bench/Judge/RecentRulings: judge id off location.pathname (stx
  // leaves window.stx._rp unset on a hard reload), lazy fetch through the auth
  // store, and show/hide via an x-class toggle rather than `:if` — bindIf drops
  // a branch that is false at first render and never brings it back, which is
  // exactly the shape of a list that arrives after a fetch.

  const authStore = useStore('auth')

  interface EducationEntry {
    degree: string
    school: string
    year: string
  }

  function resolveJudgeId(): number {
    if (typeof window === 'undefined') return 0
    // stx-standards 9.10: route params come from useRoute(), never from
    // window.stx._rp and never by re-parsing the URL. useRoute().params reads
    // a signal the runtime primes from the id the build injects into <head>,
    // ahead of the runtime itself, so it is populated on a hard reload too —
    // which is what the older note about _rp being unset was working around.
    // useRoute is auto-imported; do not hand-import it.
    const fromRouter = Number(useRoute().params.id)
    if (Number.isFinite(fromRouter) && fromRouter > 0) return fromRouter
    const m = window.location.pathname.match(/^\/judges\/(\d+)/)
    return m ? Number(m[1]) : 0
  }

  const profileJudgeId = resolveJudgeId()
  const education = state<EducationEntry[]>([])
  const educationLoaded = state<boolean>(false)

  const hasEducation = derived<boolean>(() => education().length > 0)
  const showEmptyState = derived<boolean>(() => educationLoaded() && education().length === 0)

  async function loadEducation(): Promise<void> {
    if (!profileJudgeId) {
      educationLoaded.set(true)
      return
    }
    try {
      const res = await authStore.authFetch(`/api/judges/${profileJudgeId}/education`)
      if (!res.ok) return
      const json = await res.json() as { education?: EducationEntry[] }
      education.set(Array.isArray(json?.education) ? json.education : [])
    }
    catch (err) {
      console.error('[profile] education fetch failed:', err)
    }
    finally {
      educationLoaded.set(true)
    }
  }

  onMount(() => { loadEducation() })
</script>

<div class="lg:col-span-2 lg:row-end-2 lg:row-span-2 -mx-4 px-4 py-8 sm:mx-0 sm:pb-14 sm:px-8 xl:pb-20 xl:pt-16 xl:px-16 bg-white ring-1 ring-gray-900/5 sm:rounded-lg shadow-sm">
  <h2 class="font-semibold text-base text-gray-800">Education</h2>

  {{-- Real records. Hidden until the fetch lands, so nothing flashes —
      which needs `:show`, not an x-class 'hidden' toggle. x-class is
      evaluated in the browser only, so the pre-rendered profile shell
      shipped this list and the empty state below with no 'hidden' in
      either class list, and every judge profile painted both at once
      before the runtime booted. stx-standards 7.3. --}}
  <dl class="mt-6 space-y-5" :show="hasEducation" style="display:none">
    <div :for="entry in education" class="pb-5 last:pb-0 border-b border-gray-900/5 last:border-0">
      <dt class="font-semibold text-gray-800 text-sm">{{ entry.degree }}</dt>
      <dd class="mt-1 text-gray-600 text-sm">{{ entry.school }}</dd>
      <dd class="mt-0.5 tabular-nums text-gray-500 text-xs">{{ entry.year }}</dd>
    </div>
  </dl>

  {{-- Shown only once we know there is nothing, never while loading. --}}
  <div
    class="mt-6 px-6 py-10 text-center bg-gray-50 border border-dashed border-gray-200 rounded-lg"
    :show="showEmptyState"
    style="display:none"
  >
    <h3 class="font-semibold text-base text-gray-900">Background not yet available</h3>
    <p class="mt-2 mx-auto max-w-md text-gray-600 text-sm">
      We do not hold education records for this judge, and we would rather show
      nothing than guess.
    </p>
  </div>

  <p class="mt-6 text-gray-500 text-xs">
    Education is sourced from
    <a href="https://www.courtlistener.com/person/" class="font-medium text-blue-600 underline hover:text-blue-700" rel="noopener noreferrer" target="_blank">CourtListener</a>.
    Appointment history and financial disclosures for federal judges are published by the
    <a href="https://www.fjc.gov/history/judges" class="font-medium text-blue-600 underline hover:text-blue-700" rel="noopener noreferrer" target="_blank">Federal Judicial Center</a>.
  </p>
</div>
