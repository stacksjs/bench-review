<script client>
  import type { AdminReviewRow, ReviewStatusFilter } from '~/resources/stores/adminReviews'

  const store = useStore('adminReviews')
  const confirmStore = useStore('confirm')
  const toast = useStore('toast')

  let hasFetched = false
  function bootstrap(): void {
    if (hasFetched) return
    hasFetched = true
    store.perPage.set(25)
    store.page.set(1)
    // Default the moderator view to pending — that's the queue depth
    // they care about. The status query-param (set by the dashboard
    // CTA "Open moderation queue") overrides if present.
    if (typeof window !== 'undefined') {
      const fromUrl = new URLSearchParams(window.location.search).get('status')
      if (fromUrl === 'all' || fromUrl === 'pending' || fromUrl === 'published' || fromUrl === 'rejected' || fromUrl === 'removed')
        store.statusFilter.set(fromUrl as ReviewStatusFilter)
    }
    store.fetchReviews()
  }
  bootstrap()
  onMount(() => { bootstrap() })

  // Expanded row state — single open at a time keeps the layout calm.
  // Because only one row is open, a single response-draft signal is enough
  // (no per-row state-map needed); it's seeded from the row on expand.
  const expandedId = state<number>(0)
  const responseDraft = state<string>('')
  const savingResponse = state<boolean>(false)
  // Redaction (bench-review#53): excise covered information — a home address,
  // a phone number — without deleting an otherwise lawful review.
  const redactDraft = state<string>('')
  const redactNote = state<string>('')
  const redacting = state<boolean>(false)
  const redactOpen = state<number>(0)
  // Author reveal (bench-review#56): the queue masks anonymized authors, and
  // this is the deliberate, reasoned, logged exception.
  const revealNote = state<string>('')
  const revealing = state<boolean>(false)
  const revealOpen = state<number>(0)
  // In-flight guard for the per-row Approve/Reject/Delete mutations.
  // The buttons live inside the :for, where signal call-syntax in
  // x-disabled/:text is the forbidden footgun (silently breaks the
  // loop), so this is used purely as a JS re-entry guard to stop
  // rapid double-clicks double-firing. No per-row visual binding.
  const mutatingId = state<number | null>(null)
  function openRedact(review: AdminReviewRow): void {
    redactOpen.set(redactOpen() === review.id ? 0 : review.id)
    redactDraft.set(review.content ?? '')
    redactNote.set('')
  }

  function openReveal(review: AdminReviewRow): void {
    revealOpen.set(revealOpen() === review.id ? 0 : review.id)
    revealNote.set('')
  }

  async function confirmReveal(review: AdminReviewRow): Promise<void> {
    if (revealing())
      return
    if (revealNote().trim().length < 5) {
      toast.error('Reason required', 'Say why this author needs to be identified — it goes in the moderation log.')
      return
    }
    revealing.set(true)
    try {
      if (await store.revealAuthor(review.id, revealNote().trim())) {
        revealOpen.set(0)
        toast.success('Author revealed', 'Recorded in the moderation log against your account.')
      }
      else {
        toast.error('Could not reveal', store.actionError() || 'Try again.')
      }
    }
    finally {
      revealing.set(false)
    }
  }

  async function saveRedaction(review: AdminReviewRow): Promise<void> {
    if (redacting())
      return
    if (redactNote().trim().length < 5) {
      toast.error('Reason required', 'Say why this is being redacted — it is the compliance record.')
      return
    }
    redacting.set(true)
    try {
      if (await store.redactReview(review.id, redactDraft(), redactNote().trim())) {
        redactOpen.set(0)
        toast.success('Review redacted', 'The original is preserved in the moderation log.')
      }
    }
    finally {
      redacting.set(false)
    }
  }

  function toggleExpand(review: AdminReviewRow): void {
    const opening = expandedId() !== review.id
    expandedId.set(opening ? review.id : 0)
    if (opening)
      responseDraft.set(review.response ?? '')
  }

  // Judge right-of-reply (admin-mediated). Post/replace or remove the
  // judge's official response to a review; both update the row in place.
  async function saveResponse(review: AdminReviewRow): Promise<void> {
    if (savingResponse())
      return
    savingResponse.set(true)
    await store.postResponse(review.id, responseDraft())
    savingResponse.set(false)
    toast.success('Response saved', "The judge's official response is now live under this review.")
  }
  async function removeResponse(review: AdminReviewRow): Promise<void> {
    if (typeof window === 'undefined')
      return
    if (!(await confirmStore.ask({ title: 'Remove response', message: 'Remove the judge\'s official response to this review?', confirmLabel: 'Remove', danger: true })))
      return
    if (await store.deleteResponse(review.id))
      responseDraft.set('')
  }

  function setFilter(next: ReviewStatusFilter): void {
    expandedId.set(0)
    store.setStatusFilter(next)
  }

  /**
   * The rows, each carrying its own tick state and accessible name.
   *
   * Precomputed in a derived rather than read per row in the template:
   * signal call-syntax inside a `:for` silently leaves the loop variable as
   * a function, so `x-checked="store.selectedIds().includes(review.id)"`
   * would bind every box to the same wrong answer. The `:key` on the row
   * means bindFor reuses the existing node, so ticking a box does not
   * rebuild the list under the moderator's cursor.
   */
  const rowsView = derived<Array<AdminReviewRow & {
    selected: boolean
    selectLabel: string
    authorLine: string
    revealLabel: string
  }>>(() => {
    const picked = new Set(store.selectedIds())
    const revealed = store.revealedAuthors()
    return store.reviews().map((r) => {
      // The author line, resolved here rather than in the template: the row
      // has three states (named, masked, unmasked-this-session) and branching
      // on them in the `:for` would mean signal call-syntax inside the loop.
      const shown = revealed[r.id]
      let authorLine: string
      if (shown)
        authorLine = shown.email
      else if (!r.user)
        authorLine = '(no account)'
      else if (r.user.anonymized)
        authorLine = `Anonymous · ${r.user.author_ref ?? 'ref unavailable'}`
      else
        authorLine = r.user.email ?? '(no email)'

      return {
        ...r,
        selected: picked.has(r.id),
        selectLabel: `Select review: ${r.title}`,
        authorLine,
        revealLabel: shown ? `Revealed: ${shown.name}` : 'Reveal author',
      }
    })
  })

  const selectedCount = derived<number>(() => store.selectedIds().length)
  const allVisibleSelected = derived<boolean>(() => {
    const visible = store.reviews()
    return visible.length > 0 && visible.every(r => store.selectedIds().includes(r.id))
  })
  // Tri-state: some but not all. Drives the header box's indeterminate dash,
  // which is a live DOM property with no HTML attribute behind it.
  const someVisibleSelected = derived<boolean>(() => selectedCount() > 0 && !allVisibleSelected())
  const bulkSummary = derived<string>(() => {
    const n = selectedCount()
    return n === 1 ? '1 review selected' : `${n} reviews selected`
  })

  /**
   * Confirmed, both ways round. A batch publish is not the safer direction:
   * it emails every author, notifies the claimed judge and every follower of
   * each judge, and puts the text in front of the public. Twenty-five of
   * those from one mis-click is worth a sentence first.
   */
  async function bulkModerate(status: 'published' | 'rejected'): Promise<void> {
    if (typeof window === 'undefined' || store.bulkRunning() || store.selectedIds().length === 0)
      return
    const n = store.selectedIds().length
    const noun = n === 1 ? 'review' : 'reviews'
    const ok = await confirmStore.ask(status === 'published'
      ? { title: `Publish ${n} ${noun}`, message: `Publish ${n} ${noun}? Each author is emailed, and the reviews become visible to the public.`, confirmLabel: 'Publish all' }
      : { title: `Reject ${n} ${noun}`, message: `Reject ${n} ${noun}? Each author is emailed, and the reviews are hidden from the public.`, confirmLabel: 'Reject all', danger: true })
    if (!ok)
      return
    expandedId.set(0)
    const clean = await store.bulkSetStatus(status)
    if (clean) {
      toast.success(
        status === 'published' ? `Published ${n} ${noun}` : `Rejected ${n} ${noun}`,
        status === 'published' ? 'The reviews are now visible to the public.' : 'The reviews are hidden from the public.',
      )
    }
  }

  async function approve(review: AdminReviewRow): Promise<void> {
    if (mutatingId()) return
    mutatingId.set(review.id)
    try {
      await store.setReviewStatus(review.id, 'published')
      toast.success('Review published', 'The review is now visible to the public.')
    }
    finally {
      mutatingId.set(null)
    }
  }
  async function reject(review: AdminReviewRow): Promise<void> {
    if (mutatingId()) return
    mutatingId.set(review.id)
    try {
      await store.setReviewStatus(review.id, 'rejected')
      toast.success('Review rejected', 'The review has been declined and hidden from the public.')
    }
    finally {
      mutatingId.set(null)
    }
  }
  async function confirmDelete(review: AdminReviewRow): Promise<void> {
    if (typeof window === 'undefined') return
    if (mutatingId()) return
    const ok = await confirmStore.ask({ title: 'Delete review', message: `Delete review "${review.title}"? This cannot be undone.`, confirmLabel: 'Delete', danger: true })
    if (!ok) return
    mutatingId.set(review.id)
    try {
      await store.deleteReview(review.id)
      toast.success('Review deleted', 'The review has been permanently removed.')
    }
    finally {
      mutatingId.set(null)
    }
  }

  function onSearchInput(e: Event): void {
    const value = (e.target as HTMLInputElement).value
    store.setSearch(value)
  }

  function nextPage(): void {
    if (store.page() < store.totalPages())
      store.setPage(store.page() + 1)
  }
  function prevPage(): void {
    if (store.page() > 1)
      store.setPage(store.page() - 1)
  }

  function formatDate(s: string | null | undefined): string {
    if (!s) return ''
    const d = new Date(s)
    if (Number.isNaN(d.getTime())) return ''
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
  }

  // Empty-state copy — derived so the message reads naturally for
  // the current filter and search. Composed of two lines: a short
  // headline + a quieter hint underneath. Branches on search query
  // first (search dominates filter), then on status.
  const emptyTitle = derived<string>(() => {
    const q = store.query().trim()
    if (q) return `No reviews match "${q}"`
    const status = store.statusFilter()
    if (status === 'pending') return 'No pending reviews'
    if (status === 'published') return 'No published reviews yet'
    if (status === 'rejected') return 'No rejected reviews'
    return 'No reviews yet'
  })
  const emptyHint = derived<string>(() => {
    if (store.query().trim()) return 'Try a different search term or clear the search.'
    const status = store.statusFilter()
    if (status === 'pending') return 'New submissions land here for moderation. You\'re all caught up.'
    if (status === 'published') return 'Approve a pending review to populate this list.'
    if (status === 'rejected') return 'Reviews you\'ve declined show up here.'
    return 'Submissions appear here once users start writing.'
  })

  // Filter tabs definition. Static — order is the order of importance
  // to a moderator (pending first because that's the queue depth).
  const TABS: Array<{ key: ReviewStatusFilter, label: string }> = [
    { key: 'pending', label: 'Pending' },
    { key: 'published', label: 'Published' },
    { key: 'rejected', label: 'Rejected' },
    // Taken-down reviews are invisible to the public and to their author, but
    // a moderator handling a threat report or a privacy removal needs to find
    // what was removed and when (bench-review#53).
    { key: 'removed', label: 'Removed' },
    { key: 'all', label: 'All' },
  ]
</script>

<div class="space-y-4">
  <div class="flex items-end justify-between">
    <div>
      <h1 class="font-bold text-2xl text-gray-900">Reviews</h1>
      <p class="mt-1 text-gray-600 text-sm">
        <span>{{ store.total() }}</span> <span>{{ store.statusFilter() }}</span>
      </p>
    </div>
    <div>
      <label for="reviews-search" class="sr-only">Search reviews</label>
      <input
        id="reviews-search"
        type="text"
        placeholder="Search title or content…"
        @input="onSearchInput($event)"
        class="block px-3 py-2 sm:w-72 text-gray-900 sm:text-sm placeholder:text-gray-400 bg-white border-0 ring-1 ring-gray-200 ring-inset rounded-md focus:ring-2 focus:ring-gray-600 focus:ring-inset"
      >
    </div>
  </div>

  <div class="flex gap-x-1 border-b border-gray-200">
    <button
      :for="tab in TABS"
      type="button"
      @click="setFilter(tab.key)"
      class="px-4 py-2 font-medium text-sm border-b-2 transition-colors"
      x-class="store.statusFilter() === tab.key ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900 hover:border-gray-300'">{{ tab.label }}</button>
  </div>

  <div
    role="alert"
    class="px-4 py-3 text-red-800 text-sm bg-red-50 border border-red-200 rounded-md"
    x-class="store.actionError() ? '' : 'hidden'">{{ store.actionError() }}</div>

  {{-- Bulk action bar. `:show` + inline display:none, not an x-class
      toggle: x-class is evaluated in the browser only, so the
      pre-rendered admin page would paint this bar before the runtime
      booted and then hide it. stx-standards 7.3; gate check 19. --}}
  <div
    class="flex flex-wrap gap-3 items-center justify-between px-4 py-3 bg-blue-50 border border-blue-200 rounded-md"
    :show="selectedCount() > 0"
    style="display:none"
  >
    <p class="font-medium text-blue-900 text-sm" aria-live="polite">{{ bulkSummary() }}</p>
    <div class="flex flex-wrap gap-x-2 gap-y-2">
      <button
        type="button"
        @click="bulkModerate('published')"
        x-disabled="store.bulkRunning"
        class="px-3 py-1.5 font-semibold text-white text-xs bg-emerald-600 hover:bg-emerald-700 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-700 focus-visible:outline-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
      >{{ store.bulkRunning() ? 'Working…' : 'Publish selected' }}</button>
      <button
        type="button"
        @click="bulkModerate('rejected')"
        x-disabled="store.bulkRunning"
        class="px-3 py-1.5 font-semibold text-white text-xs bg-red-600 hover:bg-red-700 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700 disabled:opacity-50 disabled:cursor-not-allowed"
      >Reject selected</button>
      <button
        type="button"
        @click="store.clearSelection()"
        class="px-3 py-1.5 font-medium text-gray-700 text-xs bg-white hover:bg-gray-50 border border-gray-300 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-600 focus-visible:outline-offset-2"
      >Clear</button>
    </div>
  </div>

  <div class="overflow-hidden bg-white border border-gray-200 rounded-lg">
    <div :if="store.loading() && store.reviews().length === 0" class="px-4 py-12 text-center text-gray-500 text-sm">
      Loading reviews…
    </div>
    {{-- Empty state. x-class hidden (not :if) so the inner :text
        bindings stay subscribed across status / query changes —
        bindIf's remove/re-add cycle drops bindings on the re-add
        (same footgun the login form hit; see login.stx). --}}
    {{-- `:show`, not an x-class 'hidden' toggle. x-class is evaluated in
        the browser only, so the pre-rendered admin page painted this
        before the runtime booted. stx-standards 7.3; gate check 19. --}}
    <div
      class="px-6 py-16 text-center"
      :show="!store.loading() && store.reviews().length === 0"
      style="display:none"
    >
      <div class="flex items-center justify-center mb-4 mx-auto h-12 w-12 bg-gray-50 rounded-full">
        <svg class="h-6 w-6 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 12h6m-6 4h6M7 4h10a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2z" />
        </svg>
      </div>
      <p class="font-semibold text-gray-900 text-sm">{{ emptyTitle() }}</p>
      <p class="mt-1 mx-auto max-w-md leading-relaxed text-gray-500 text-xs">{{ emptyHint() }}</p>
    </div>
    {{-- x-class hidden (not :if) so the inner :for keeps its
        subscription across the loading -> loaded transition. The
        :if remove/re-add cycle drops the :for binding on re-add and
        the rows never render even after reviews() populates. --}}
    {{-- Select-all for the current page. Page-scoped on purpose: the store
        clears the selection on every fetch, so this can only ever act on
        rows the moderator is actually looking at. --}}
    <div
      class="flex gap-x-3 items-center px-4 py-2.5 bg-gray-50 border-b border-gray-200"
      :show="store.reviews().length > 0"
      style="display:none"
    >
      <input
        id="reviews-select-all"
        type="checkbox"
        @change="store.toggleSelectAll()"
        x-checked="allVisibleSelected"
        x-indeterminate="someVisibleSelected"
        class="h-4 w-4 text-blue-600 border-gray-300 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2"
      >
      <label for="reviews-select-all" class="font-medium text-gray-600 text-xs">Select all on this page</label>
    </div>
    <ul class="divide-gray-100 divide-y" :show="store.reviews().length > 0" style="display:none">
      {{-- `:key` so bindFor reuses each row's existing node. Without it the
          key falls back to the index, and ticking a box would rebuild the
          whole list — blurring the checkbox the moderator just used and
          detaching an open row's response textarea mid-edit. --}}
      <li :for="review in rowsView()" :key="review.id" class="px-4 py-4">
        <div class="flex gap-x-4 justify-between">
          <input
            type="checkbox"
            @change="store.toggleSelected(review.id)"
            x-checked="review.selected"
            x-aria-label="review.selectLabel"
            class="flex-none mt-1 h-4 w-4 text-blue-600 border-gray-300 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2"
          >
          <div class="flex-1 min-w-0">
            <div class="flex gap-x-2 items-center">
              <span
                class="inline-block px-2 py-0.5 font-medium text-xs rounded-full"
                x-class="review.status === 'published' ? 'bg-emerald-100 text-emerald-800' : review.status === 'rejected' ? 'bg-red-100 text-red-800' : review.status === 'removed' ? 'bg-gray-800 text-white' : 'bg-amber-100 text-amber-800'">{{ review.status }}</span>
              <span class="text-gray-500 text-xs">{{ formatDate(review.created_at) }}</span>
              {{-- Reported. Shown on the row the publish decision is made
                  on, because the flags queue is a separate page and a
                  moderator should not have to know to go and look first.
                  Links straight there. --}}
              <StxLink
                :if="review.open_flags"
                to="/admin/flags"
                class="inline-block px-2 py-0.5 font-medium text-red-800 text-xs bg-red-100 hover:bg-red-200 rounded-full transition-colors"
              >{{ review.open_flags === 1 ? '1 open report' : review.open_flags + ' open reports' }}</StxLink>
            </div>
            <h3 class="mt-1 font-semibold text-base text-gray-900">{{ review.title }}</h3>
            <p class="mt-1 text-gray-600 text-sm">
              <span>{{ review.judge.name }}</span>
              <span class="text-gray-400"> · </span>
              {{-- The author, masked when they asked to be anonymous
                  (bench-review#56). `Anonymous · A-…` is a stable per-author
                  ref, so repeat abuse is still visible here without anyone
                  being identified. Precomputed in `rowsView`. --}}
              <span>{{ review.authorLine }}</span>
              <span class="text-gray-400"> · </span>
              <span>{{ '★ ' + review.rating }}</span>
            </p>

            {{-- Attached photos. A moderator approving a review with images
                was deciding blind: nothing in this queue rendered them, and
                images are the highest-risk content the site accepts — a
                face, a document, an address. Thumbnails only; the link opens
                the full size in a new tab for a closer look
                (bench-review#51). --}}
            <div class="flex flex-wrap gap-2 mt-3">
              <a
                :for="photo in review.photos"
                x-href="photo.full_url"
                target="_blank"
                rel="noopener noreferrer"
                {{-- flex-none, or the thumbnail collapses. As a shrinkable child of
                    the wrapping flex row it shrinks to min-content, and
                    min-content for an image that has not loaded yet is zero —
                    measured at 2px wide (the borders) with a correct 64px
                    height, which is a confusing shape to debug later. --}}
                class="block overflow-hidden flex-none h-16 w-16 bg-gray-100 border border-gray-200 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2"
              >
                {{-- Static src as well as the binding. An <img> whose only
                    source is x-src ships with no src at all in the
                    pre-rendered page: a broken-image glyph until the runtime
                    boots, and in some browsers a request back at the page
                    URL. Gate check 2 catches it; same pattern as
                    ProfileHeader's avatar. --}}
                <img src="/images/avatars/default-user.svg" x-src="photo.thumb_url" alt="Photo attached to this review" loading="lazy" class="object-cover h-full w-full" />
              </a>
            </div>
          </div>
          <div class="flex flex-col flex-shrink-0 gap-y-1 items-end">
            <div class="flex gap-x-2">
              <button
                type="button"
                @click="approve(review)"
                x-disabled="review.status === 'published'"
                class="px-2.5 py-1 font-medium text-emerald-800 text-xs bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded disabled:opacity-40 disabled:cursor-not-allowed"
              >Approve</button>
              <button
                type="button"
                @click="reject(review)"
                x-disabled="review.status === 'rejected'"
                class="px-2.5 py-1 font-medium text-amber-800 text-xs bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded disabled:opacity-40 disabled:cursor-not-allowed"
              >Reject</button>
              <button
                type="button"
                @click="confirmDelete(review)"
                class="px-2.5 py-1 font-medium text-red-800 text-xs bg-red-50 hover:bg-red-100 border border-red-200 rounded"
              >Delete</button>
            </div>
            <button
              type="button"
              @click="toggleExpand(review)"
              class="text-gray-500 text-xs hover:text-gray-900">{{ expandedId() === review.id ? 'Hide content' : 'Show content' }}</button>
          </div>
        </div>
        <div class="mt-3 space-y-3" x-class="expandedId() === review.id ? '' : 'hidden'">
          <div class="px-4 py-3 max-w-none bg-gray-50 rounded prose prose-sm" x-html="review.content"></div>

          {{-- Author reveal (bench-review#56). The queue shows anonymized
              authors as `Anonymous · A-…`, because a single compromised
              moderator account used to be enough to de-anonymize every
              anonymous reviewer on the site at once, silently. Revealing one
              is still allowed — threats and subpoenas have to be actionable —
              but it costs a reason and leaves a log entry with your name on
              it. --}}
          <div class="px-4 py-3 bg-gray-50 border border-gray-300 rounded">
            <div class="flex items-center justify-between">
              <label class="block font-semibold text-gray-700 text-xs tracking-wide uppercase">Author identity</label>
              <button
                type="button"
                @click="openReveal(review)"
                class="px-2 py-0.5 font-medium text-gray-800 text-xs bg-white hover:bg-gray-100 border border-gray-300 rounded"
              >{{ review.revealLabel }}</button>
            </div>
            <p class="mt-0.5 text-gray-500 text-xs">Anonymous reviewers are masked here. The ref stays the same across everything one person writes, so you can spot a repeat without identifying anyone. Revealing is logged against your account.</p>

            <div x-class="revealOpen() === review.id ? '' : 'hidden'">
              <input
                x-model="revealNote"
                type="text"
                placeholder="Why — e.g. threat assessment, subpoena 24-1193"
                aria-label="Reason for revealing this author"
                class="block mt-2 px-3 py-2 w-full text-gray-900 text-xs bg-white border border-gray-300 rounded-md focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
              >
              <button
                type="button"
                @click="confirmReveal(review)"
                x-disabled="revealing"
                class="mt-2 px-3 py-1.5 font-semibold text-white text-xs bg-gray-800 hover:bg-gray-900 rounded disabled:opacity-50"
              >{{ revealing() ? 'Revealing…' : 'Reveal and log' }}</button>
            </div>
          </div>

          {{-- Redaction (bench-review#53). Separate from the status buttons
              because it is a different decision: the review stays published,
              only the covered information goes. Deleting a lawful review for
              one sentence is over-removal. --}}
          <div class="px-4 py-3 bg-red-50/40 border border-red-200 rounded">
            <div class="flex items-center justify-between">
              <label class="block font-semibold text-red-800 text-xs tracking-wide uppercase">Redact content</label>
              <button
                type="button"
                @click="openRedact(review)"
                class="px-2 py-0.5 font-medium text-red-800 text-xs bg-white hover:bg-red-50 border border-red-200 rounded"
              >{{ redactOpen() === review.id ? 'Close' : 'Edit content' }}</button>
            </div>
            <p class="mt-0.5 text-gray-500 text-xs">Removes a home address, phone number or similar while leaving the review up. The original is preserved in the moderation log.</p>

            <div x-class="redactOpen() === review.id ? '' : 'hidden'">
              <textarea
                x-model="redactDraft"
                rows="6"
                aria-label="Redacted review content"
                class="block mt-2 px-3 py-2 w-full font-mono text-gray-900 text-xs bg-white border border-gray-300 rounded-md focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-200"
              ></textarea>
              <input
                x-model="redactNote"
                type="text"
                placeholder="Why — e.g. removal request, home address"
                aria-label="Reason for redaction"
                class="block mt-2 px-3 py-2 w-full text-gray-900 text-xs bg-white border border-gray-300 rounded-md focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-200"
              >
              <button
                type="button"
                @click="saveRedaction(review)"
                x-disabled="redacting"
                class="mt-2 px-3 py-1.5 font-semibold text-white text-xs bg-red-600 hover:bg-red-700 rounded disabled:opacity-50"
              >{{ redacting() ? 'Saving…' : 'Save redaction' }}</button>
            </div>
          </div>

          {{-- Judge right-of-reply composer. Posted on the judge's behalf
              (admin-mediated); renders publicly under the review. --}}
          <div class="px-4 py-3 bg-amber-50/40 border border-amber-200 rounded">
            <label class="block font-semibold text-amber-800 text-xs tracking-wide uppercase">Judge's official response (right-of-reply)</label>
            <p class="mt-0.5 text-gray-500 text-xs">Posted on the judge's behalf. Shows publicly under the review.</p>
            <textarea
              x-model="responseDraft"
              rows="4"
              aria-label="Judge's official response"
              placeholder="Enter the judge's official response…"
              class="block mt-2 px-3 py-2 w-full text-gray-900 text-sm bg-white border border-gray-300 rounded-md focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
            ></textarea>
            <div class="flex gap-x-2 mt-2">
              <button
                type="button"
                @click="saveResponse(review)"
                x-disabled="savingResponse"
                class="inline-flex items-center justify-center px-3 py-1.5 font-semibold text-white text-xs bg-blue-600 hover:bg-blue-700 rounded disabled:opacity-50"
              >
                <svg :if="savingResponse()" class="-ml-0.5 mr-2 h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25"></circle><path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg>
                <span>{{ savingResponse() ? 'Saving…' : 'Save response' }}</span>
              </button>
              <button
                type="button"
                @click="removeResponse(review)"
                x-class="review.response ? '' : 'hidden'"
                class="px-3 py-1.5 font-medium text-red-700 text-xs bg-white hover:bg-red-50 border border-red-200 rounded"
              >Remove</button>
            </div>
          </div>
        </div>
      </li>
    </ul>
  </div>

  <div class="flex items-center justify-between">
    <p class="text-gray-500 text-sm">
      Page <span>{{ store.page() }}</span> of <span>{{ store.totalPages() }}</span>
    </p>
    <div class="flex gap-x-2">
      <button
        type="button"
        @click="prevPage()"
        x-disabled="store.page() <= 1"
        class="px-3 py-1.5 font-medium text-gray-700 text-sm bg-white hover:bg-gray-50 border border-gray-300 rounded disabled:opacity-50 disabled:cursor-not-allowed"
      >Previous</button>
      <button
        type="button"
        @click="nextPage()"
        x-disabled="store.page() >= store.totalPages()"
        class="px-3 py-1.5 font-medium text-gray-700 text-sm bg-white hover:bg-gray-50 border border-gray-300 rounded disabled:opacity-50 disabled:cursor-not-allowed"
      >Next</button>
    </div>
  </div>
</div>
