<script client>
  // Email verification (bench launch trust gate). One component, two entry
  // points distinguished by the URL:
  //   /verify-email/{id}/{token}  → auto-verify the emailed token on mount
  //   /verify-email               → "check your inbox" landing + resend
  //
  // Logic lives HERE (component scope), not in the view: view-level
  // `<script client>` is silently dropped — only components get scopes
  // (feedback_stx_view_vs_component_scripts). The id/token are parsed from
  // location.pathname because router params are unset on hard reload
  // (feedback_stx_rp_unset_on_hard_reload), and a verification link is
  // almost always a cold load from a mail client.

  const authStore = useStore('auth')

  let redirectTimer: ReturnType<typeof setTimeout> | null = null
  onDestroy(() => { if (redirectTimer !== null) clearTimeout(redirectTimer) })

  const phase = state('idle') // 'idle' | 'verifying' | 'verified' | 'error'
  const message = state('')
  const hasLink = state(false)
  const resending = state(false)
  const resendNote = state('')

  function parseLink() {
    if (typeof window === 'undefined')
      return null
    const m = window.location.pathname.match(/^\/verify-email\/(\d+)\/(.+)$/)
    if (!m)
      return null
    return { id: Number(m[1]), token: decodeURIComponent(m[2]) }
  }

  async function verify() {
    const link = parseLink()
    if (!link)
      return
    phase.set('verifying')
    const result = await authStore.verifyEmail(link.id, link.token)
    if (!result.ok) {
      message.set(result.message || 'This verification link is invalid or has expired.')
      phase.set('error')
      return
    }
    phase.set('verified')
    // Hold the success state long enough to read, then move on. Tracked and
    // cancelled: an uncancelled redirect timer survives the component in any
    // environment that swaps the page without discarding the document — the
    // dev server navigates client-side — and would yank someone out of
    // whatever they opened in the meantime. stx-standards 6.7.
    redirectTimer = setTimeout(() => { navigate('/profile', true) }, 1800)
  }

  async function resend() {
    if (resending())
      return
    resending.set(true)
    resendNote.set('')
    try {
      const res = await authStore.authFetch('/api/auth/resend-verification', { method: 'POST' })
      const data = await res.json().catch(() => ({}))
      resendNote.set(data.success ? 'Sent — check your inbox.' : (data.message || 'Could not resend right now.'))
    }
    catch {
      resendNote.set('Could not resend right now.')
    }
    finally {
      resending.set(false)
    }
  }

  onMount(() => {
    if (parseLink()) {
      hasLink.set(true)
      verify()
    }
  })
</script>

<div class="flex items-center justify-center px-4 min-h-[60vh]">
  <div class="p-8 max-w-md w-full text-center bg-white border border-gray-200 rounded-2xl shadow-sm">
    {{-- Verifying.

        All four blocks below toggle with `:show`, not an x-class 'hidden'
        branch. x-class is evaluated in the browser only, so the
        pre-rendered page shipped every one of them without 'hidden' and
        painted all four states at once — 'Verifying your email…',
        'Email verified', 'Verification failed' and 'Check your inbox'
        stacked in one card — until the runtime booted and picked one.
        They are mutually exclusive by construction, so that was never a
        state a user should see. `:show` is cloaked at build time, which
        is the half x-class cannot do. stx-standards 7.3. --}}
    <div :show="phase() === 'verifying'" style="display:none">
      <h1 class="font-bold font-serif text-2xl text-gray-900">Verifying your email…</h1>
      <p class="mt-2 text-gray-500 text-sm">One moment while we confirm your link.</p>
    </div>

    {{-- Verified --}}
    <div :show="phase() === 'verified'" style="display:none">
      <h1 class="font-bold font-serif text-2xl text-emerald-700">Email verified ✓</h1>
      <p class="mt-2 text-gray-600 text-sm">You're all set — taking you to your profile…</p>
    </div>

    {{-- Error (bad/expired link) --}}
    <div :show="phase() === 'error'" style="display:none">
      <h1 class="font-bold font-serif text-2xl text-gray-900">Verification failed</h1>
      <p class="mt-2 text-gray-600 text-sm" :text="message()"></p>
      <button
        type="button"
        @click="resend()"
        x-disabled="resending"
        class="inline-flex items-center mt-5 px-4 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-md disabled:opacity-50"
        :text="resending() ? 'Sending…' : 'Resend verification email'"
      >Resend verification email</button>
      <p class="mt-3 text-gray-500 text-xs" :text="resendNote()"></p>
    </div>

    {{-- Landing (arrived at /verify-email with no token) --}}
    <div :show="!hasLink()" style="display:none">
      <h1 class="font-bold font-serif text-2xl text-gray-900">Check your inbox</h1>
      <p class="mt-2 text-gray-600 text-sm">We've sent a verification link to your email address. Click it to verify your account — you'll need a verified email to post reviews.</p>
      <button
        type="button"
        @click="resend()"
        x-disabled="resending"
        class="inline-flex items-center mt-5 px-4 py-2 font-semibold text-gray-800 text-sm bg-white hover:bg-gray-50 border border-gray-300 rounded-md disabled:opacity-50"
        :text="resending() ? 'Sending…' : 'Resend verification email'"
      >Resend verification email</button>
      <p class="mt-3 text-gray-500 text-xs" :text="resendNote()"></p>
    </div>
  </div>
</div>
