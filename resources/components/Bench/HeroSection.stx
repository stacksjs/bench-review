<section>
  <div class="relative isolate">
    {{-- Ambient brand light behind the hero. Sits under a real hero
        image (below), so this is depth, not a gradient-blob stand-in.
        pointer-events-none + aria-hidden keeps it purely decorative. --}}
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10" aria-hidden="true">
      <div class="absolute right-0 h-80 w-80 bg-blue-400/20 rounded-full blur-3xl -top-20"></div>
      <div class="absolute top-40 h-72 w-72 bg-blue-500/10 rounded-full blur-3xl -left-24"></div>
    </div>
    <div class="overflow-hidden">
      <div class="mx-auto pb-32 pt-8 px-6 sm:pt-12 lg:pt-16 lg:px-8 max-w-7xl">
        <div class="lg:flex gap-x-14 lg:items-center mx-auto lg:mx-0 max-w-2xl lg:max-w-none">
          <div class="relative lg:shrink-0 w-full lg:max-w-xl xl:max-w-2xl">
            <h1 class="font-semibold text-5xl text-gray-900 text-pretty tracking-tight sm:text-6xl">Transparency in the judiciary starts here</h1>

            <p class="mt-6 sm:max-w-md lg:max-w-none font-medium text-gray-600 text-lg text-pretty sm:text-xl/8">
              Like Glassdoor, but for the judiciary: reviews of judges from the clerks, attorneys, and court staff who appear before them.</p>
            <div class="flex gap-x-6 items-center mt-10">
              <StxLink to="/judges"
                class="px-5 py-3 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 shadow-blue-600/25 shadow-sm transition active:scale-[0.98]">Browse judges</StxLink>
              <StxLink to="/review" class="font-semibold text-blue-700 text-sm/6 hover:text-blue-900 transition-colors">Write a review <span
                  aria-hidden="true">→</span></StxLink>
            </div>
          </div>
          <div class="flex justify-center mt-14 lg:mt-0">
            <div class="max-w-2xl w-full">
              <div class="relative">
                <StxImage src="/images/bench/hero-image.webp" alt="Bench Hero" sizes="sm:100vw md:100vw lg:50vw"
                  class="object-cover w-full rounded-2xl" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
