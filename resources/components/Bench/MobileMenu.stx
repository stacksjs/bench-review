{{--
  UNWIRED. Nothing includes this component, and it will not work as written —
  it is kept because it records the intended mobile nav, not because it runs.

  It is the only candidate answer to a real gap: BenchHeader hides all three
  of its regions below `lg` (`hidden lg:flex` on the links, the search and the
  auth buttons) and offers no hamburger, so on a phone the site header is the
  logo and nothing else. That is also what the iOS app will show, since the
  app is a WebView over this same site.

  What has to be fixed before it can be included (bench-review#90):
    - `isOpen` and `isAuthenticated` are not defined in this component's own
      scope and no parent passes them; a component const or a
      `useStore('auth')` reference has to supply both.
    - `:if="isOpen"` is the wrong binder for a toggle that is false on first
      render — bindIf drops it and never re-renders. Use `:show` with a static
      `style="display:none"`, per stx-standards 7.3 and gate check 19.
    - `isAuthenticated` is read both with and without parens in the same file.
    - `<StxLink to="/logout">` points at a route that does not exist. Logout is
      a store action; BenchHeader calls `auth.logout()`.
    - `$dispatch('close')` is unverified against this stx version.
--}}

<script client>
  const mobileSearchQuery = state<string>('')

  function submitMobileSearch(): void {
    navigate(`/search?q=${encodeURIComponent(mobileSearchQuery())}`, true)
  }
</script>

<div :if="isOpen" class="lg:hidden" role="dialog" aria-modal="true">
  {{-- Background backdrop, show/hide based on slide-over state. --}}
  <div class="fixed inset-0 z-50"></div>
  <div class="fixed inset-y-0 overflow-y-auto right-0 z-50 px-6 py-6 w-full sm:max-w-sm bg-white sm:ring-1 sm:ring-gray-900/10">
    <div class="flex items-center justify-between">
      <StxLink to="/" class="-m-1.5 p-1.5">
        <span class="sr-only">Judge Review</span>
        <img class="h-8 w-auto" src="/images/bench/logo.png" alt="Bench Review">
      </StxLink>
      <button @click="$dispatch('close')" type="button" class="-m-2.5 p-2.5 text-gray-700 rounded-md">
        <span class="sr-only">Close menu</span>
        <Icon name="x" size="24" />
      </button>
    </div>
    <div class="flow-root mt-6">
      <div class="-my-6 divide-gray-500/10 divide-y">
        <div class="py-6 space-y-2">
          <form
            @submit.prevent="submitMobileSearch()"
            class="-mx-3 mb-4 px-3"
          >
            <div class="relative">
              <div class="flex absolute inset-y-0 left-0 items-center pl-3 pointer-events-none">
                <Icon name="search" size="16" class="text-gray-400" />
              </div>
              <input
                type="text"
                x-model="mobileSearchQuery"
                aria-label="Search judges or courts"
                placeholder="Search judges or courts..."
                class="block pl-9 pr-3 py-2 w-full text-gray-900 sm:text-sm placeholder:text-gray-400 bg-white border-0 ring-1 ring-gray-200 ring-inset rounded-lg focus:ring-2 focus:ring-blue-600 focus:ring-inset"
              >
            </div>
          </form>

          <StxLink to="/judges" class="block -mx-3 px-3 py-2 font-semibold text-base/7 text-gray-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg">Find Judges</StxLink>
          <StxLink to="/court-houses" class="block -mx-3 px-3 py-2 font-semibold text-base/7 text-gray-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg">Court Houses</StxLink>
          <StxLink to="/review" class="block -mx-3 px-3 py-2 font-semibold text-base/7 text-gray-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg">Write a Review</StxLink>
          <StxLink to="/reviews" class="block -mx-3 px-3 py-2 font-semibold text-base/7 text-gray-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg">Reviews</StxLink>
          <div :if="isAuthenticated">
            <StxLink to="/notifications" class="block -mx-3 px-3 py-2 font-semibold text-base/7 text-gray-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg">Notifications</StxLink>
            <StxLink to="/profile" class="block -mx-3 px-3 py-2 font-semibold text-base/7 text-gray-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg">Profile</StxLink>
            <StxLink to="/settings" class="block -mx-3 px-3 py-2 font-semibold text-base/7 text-gray-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg">Settings</StxLink>
          </div>
          <StxLink to="/judges/submit" class="block -mx-3 px-3 py-2 font-semibold text-base/7 text-gray-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg">Submit a Judge</StxLink>
        </div>
        <div class="py-6">
          <div :if="!isAuthenticated()">
            <StxLink to="/register" class="block -mx-3 mb-2 px-3 py-2.5 font-semibold text-base/7 text-center text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-blue-600/25 shadow-sm transition active:scale-[0.98]">Register</StxLink>
            <StxLink to="/login" class="block -mx-3 px-3 py-2.5 font-semibold text-base/7 text-gray-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg">Log in</StxLink>
          </div>
          <div :else>
            <StxLink to="/logout" class="block -mx-3 px-3 py-2.5 font-semibold text-base/7 text-gray-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg">Log out</StxLink>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
