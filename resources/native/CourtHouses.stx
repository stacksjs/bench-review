<script client lang="ts">
// The courthouse directory, drawn natively (config/mobile.ts
// `nativeScreens`, /court-houses).
//
// Same public endpoint as the website, GET /api/court-houses, which returns
// each courthouse already hydrated with its active-judge count and review
// aggregates — so the rows need one request and no per-row follow-up.
import { getJson, keepSnapshot, readSnapshot } from '../functions/native-api'
import { buildPages, lastPageOf, pageSlice } from '../functions/native-paging'
import { ui } from '../functions/native-ui'

interface CourtHouse {
  id: number
  name: string
  city?: string | null
  state?: string | null
  active_judges?: number | null
  total_reviews?: number | null
}

const SNAPSHOT = 'court-houses'

const craft = (globalThis as any).craft
const kept = readSnapshot<CourtHouse[]>(SNAPSHOT)

const courts = state<CourtHouse[]>(kept ?? [])
const term = state('')
const loading = state(!kept?.length)
const failed = state(false)
const offline = state(false)

let alive = true

const filtered = derived<CourtHouse[]>(() => {
  const needle = term().trim().toLowerCase()
  const all = courts()
  if (!needle)
    return all
  return all.filter(c =>
    String(c.name || '').toLowerCase().includes(needle)
    || String(c.city || '').toLowerCase().includes(needle)
    || String(c.state || '').toLowerCase().includes(needle),
  )
})

const rows = derived(() => pageSlice(filtered(), currentPage()).map(c => ({
  key: c.id,
  name: c.name || 'Unnamed courthouse',
  // Joined only when both halves exist: most federal appellate courts carry a
  // state and no city, and concatenating unconditionally rendered ", DC"
  // on the web until bench-review#56.
  where: [c.city, c.state].filter(Boolean).join(', '),
  judges: Number(c.active_judges || 0) === 1 ? '1 judge' : `${Number(c.active_judges || 0)} judges`,
})))

// Numbered pagination (Prev / 1 2 … N / Next), matching the web directory.
// The endpoint returns the whole directory in one bounded query, so paging is
// over the list already held: a page change costs nothing and works offline.
const currentPage = state<number>(1)
const lastPage = derived<number>(() => lastPageOf(filtered().length))
const pages = derived(() => buildPages(currentPage(), lastPage()))

function goToPage(n: number): void {
  if (!n || n === currentPage())
    return
  currentPage.set(Math.max(1, Math.min(n, lastPage())))
}

function prevPage(): void {
  goToPage(currentPage() - 1)
}

function nextPage(): void {
  goToPage(currentPage() + 1)
}

const summary = derived<string>(() => {
  if (loading() && !courts().length)
    return ''
  const n = filtered().length
  return n === 1 ? '1 courthouse' : `${n} courthouses`
})

const reason = derived<string>(() => {
  if (offline())
    return 'Could not reach Bench Review. Courthouses will load when you are back online.'
  if (failed())
    return 'The courthouses could not be loaded.'
  if (term().trim())
    return 'No courthouses match that search.'
  return 'No courthouses yet.'
})

const nothing = derived<boolean>(() => !loading() && (failed() || !filtered().length))
const showSkeleton = derived<boolean>(() => loading() && !courts().length)

effect(() => craft?.navigation?.setOptions({ title: 'Courthouses', largeTitle: true }))

async function load(): Promise<void> {
  failed.set(false)
  offline.set(false)
  try {
    const data = await getJson<CourtHouse[]>('/api/court-houses')
    if (!alive)
      return
    courts.set(Array.isArray(data) ? data : [])
    keepSnapshot(SNAPSHOT, Array.isArray(data) ? data : [])
  }
  catch (err) {
    if (!alive)
      return
    failed.set(true)
    offline.set((err as any)?.status === 0)
  }
  finally {
    if (alive)
      loading.set(false)
  }
}

function typed(value: string): void {
  term.set(value)
  currentPage.set(1)
}

function clear(): void {
  term.set('')
  currentPage.set(1)
}

async function refresh(): Promise<void> {
  await load()
}

onMount(() => {
  alive = true
  void load()
  return () => { alive = false }
})
</script>

<template>
  <View :class="ui.screen">
    <ScrollView class="flex-1" @refresh="refresh()" :refreshing="loading() && courts().length > 0" keyboardDismissMode="on-drag">
      <View class="mt-2" :class="ui.search">
        <Icon name="search" class="h-4 w-4 text-[#8e8e93]" />
        <TextInput
          class="flex-1 text-[17px] text-black dark:text-white border-0"
          :value="term()"
          @input="typed($event.text)"
          returnKeyType="search"
          autoCapitalize="none"
          :autoCorrect="false"
          placeholder="Search by name, city, or state"
          placeholderTextColor="#8e8e93"
          accessibilityLabel="Search courthouses"
          testID="courts-search"
        />
        <Pressable :if="term().length > 0" @press="clear()" accessibilityRole="button" accessibilityLabel="Clear search" testID="courts-clear">
          <Icon name="circle-x" class="h-4 w-4 text-[#8e8e93]" />
        </Pressable>
      </View>

      <Text :if="summary()" :class="ui.header" :text="summary()" testID="courts-summary" />

      <View :if="rows().length > 0" :class="ui.group" testID="courts-list">
        <View :for="(row, index) in rows()" :key="row.key">
          <View :if="index" :class="ui.separator" />
          <View class="flex-row gap-3 items-center px-4 py-2.5 min-h-[44px]" :testID="'court-' + row.key">
            <View class="flex-1">
              <Text :numberOfLines="2" :class="ui.title" :text="row.name" />
              <Text :if="row.where" :numberOfLines="1" :class="ui.subtitle" :text="row.where" />
            </View>
            <Text :class="ui.caption" :text="row.judges" />
          </View>
        </View>
      </View>

      <View :if="showSkeleton()" class="mt-7" :class="ui.group" testID="courts-loading">
        <View :for="n in [1, 2, 3]" :key="n" class="gap-2 px-4 py-3.5">
          <View class="h-3.5 w-2/3" :class="ui.skeleton" />
          <View class="h-3 w-1/3" :class="ui.skeleton" />
        </View>
      </View>

      <View :if="nothing()" class="items-center mt-7 py-6" :class="ui.card" accessibilityRole="alert" testID="courts-empty">
        <Icon :name="offline() ? 'wifi-off' : 'building'" class="h-7 w-7 text-[#c7c7cc] dark:text-[#48484a]" />
        <Text class="mt-3 text-center" :class="ui.subtitle" :text="reason()" />
        <Pressable :if="failed()" @press="refresh()" class="justify-center mt-2 min-h-[44px]" accessibilityRole="button" testID="courts-retry">
          <Text class="text-[17px]" :class="ui.tint" text="Try again" />
        </Pressable>
      </View>


      {{-- Prev / 1 2 … N / Next, the same pager the web directory draws. The
          page pills sit in a `:for`, and a tap handler that references the
          loop variable is the one thing not yet firing in the native runtime
          (see the note in resources/native/Judges.stx), so Prev and Next —
          which reference nothing from a loop — are the controls that are
          known to work today. --}}
      <View :if="lastPage() > 1" class="flex-row gap-2 items-center justify-center mb-10 mt-6" testID="courts-pager">
        <Pressable @press="prevPage()" class="justify-center px-3 min-h-[44px]" accessibilityRole="button" accessibilityLabel="Previous page" testID="courts-prev">
          <Text class="text-[17px]" :class="currentPage() > 1 ? ui.tint : ui.caption" text="Prev" />
        </Pressable>

        <View :for="item in pages()" :key="item.label + '-' + item.n">
          <Text :if="item.gap" :class="ui.caption" text="…" />
          <Pressable :if="!item.gap" @press="goToPage(item.n)" class="items-center justify-center px-3 min-h-[44px] rounded-[8px]" :class="item.active ? 'bg-[#2563eb]' : ''" accessibilityRole="button" :accessibilityLabel="'Page ' + item.label" :testID="'courts-page-' + item.label">
            <Text class="text-[17px]" :class="item.active ? 'font-semibold text-white' : ui.tint" :text="item.label" />
          </Pressable>
        </View>

        <Pressable @press="nextPage()" class="justify-center px-3 min-h-[44px]" accessibilityRole="button" accessibilityLabel="Next page" testID="courts-next">
          <Text class="text-[17px]" :class="currentPage() < lastPage() ? ui.tint : ui.caption" text="Next" />
        </Pressable>
      </View>

      <View class="h-12" />
    </ScrollView>
  </View>
</template>
