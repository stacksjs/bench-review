<script client lang="ts">
// The judge directory, drawn natively (config/mobile.ts `nativeScreens`,
// /judges): the phone's half of resources/components/Bench/Judge/
// JudgeDirectory.stx.
//
// Reads the same public endpoint the website does, GET /api/judges, which
// needs no session. Searching is local to the page already held, which is the
// honest thing at this size: the endpoint returns the whole directory in one
// bounded query (bench-review#56), so a keystroke costs nothing and works
// with the network off.
//
// A row pushes the judge's own screen (Judge.stx) with the row itself, so
// opening one is instant and needs no second request — there is no
// /api/judges/{id} endpoint to call anyway.
import { getJson, keepSnapshot, readSnapshot } from '../functions/native-api'
import { buildPages, lastPageOf, pageSlice } from '../functions/native-paging'
import { initials, ui } from '../functions/native-ui'

interface Judge {
  id: number
  name: string
  photo?: string | null
  location?: string | null
  practice_area?: string | null
  court?: { id: number | null, name: string | null, image?: string | null }
}

const SNAPSHOT = 'judges'

const craft = (globalThis as any).craft
const kept = readSnapshot<Judge[]>(SNAPSHOT)

const judges = state<Judge[]>(kept ?? [])
const term = state('')
const loading = state(!kept?.length)
const failed = state(false)
const offline = state(false)

let alive = true

const filtered = derived<Judge[]>(() => {
  const needle = term().trim().toLowerCase()
  const all = judges()
  if (!needle)
    return all
  return all.filter(j =>
    String(j.name || '').toLowerCase().includes(needle)
    || String(j.court?.name || '').toLowerCase().includes(needle)
    || String(j.location || '').toLowerCase().includes(needle),
  )
})

// Rows carry their own display strings, so the template never calls a signal
// inside its `:for` — the same rule the web components follow.
const rows = derived(() => pageSlice(filtered(), currentPage()).map(j => ({
  judge: j,
  key: j.id,
  name: j.name || 'Unnamed judge',
  where: [j.court?.name, j.location].filter(Boolean).join(' · '),
  mark: initials(j.name),
  photo: j.photo || '',
})))

// Numbered pagination (Prev / 1 2 … N / Next), matching the web directory.
// The endpoint returns the whole directory in one bounded query, so paging is
// over the list already held: a page change costs nothing and works offline.
const currentPage = state<number>(1)
const lastPage = derived<number>(() => lastPageOf(filtered().length))
const pages = derived(() => buildPages(currentPage(), lastPage()))

function goToPage(n: number): void {
  if (!n || n === currentPage())
    return
  currentPage.set(Math.max(1, Math.min(n, lastPage())))
}

function prevPage(): void {
  goToPage(currentPage() - 1)
}

function nextPage(): void {
  goToPage(currentPage() + 1)
}

const summary = derived<string>(() => {
  if (loading() && !judges().length)
    return ''
  const total = filtered().length
  if (term().trim())
    return total === 1 ? '1 judge found' : `${total} judges found`
  return total === 1 ? '1 judge' : `${total} judges`
})

// What the empty card says. A failed load is NOT "no judges" — that is a claim
// about the content, and it is false during an outage. The web directory
// carries the same distinction (bench-review#55).
const reason = derived<string>(() => {
  if (offline())
    return 'Could not reach Bench Review. The directory will load when you are back online.'
  if (failed())
    return 'The directory could not be loaded. This is a problem on our side.'
  if (term().trim())
    return 'No judges match that search.'
  return 'No judges yet.'
})

const nothing = derived<boolean>(() => !loading() && (failed() || !filtered().length))
const showSkeleton = derived<boolean>(() => loading() && !judges().length)

effect(() => craft?.navigation?.setOptions({ title: 'Judges', largeTitle: true }))

async function load(): Promise<void> {
  failed.set(false)
  offline.set(false)
  try {
    const data = await getJson<Judge[]>('/api/judges')
    if (!alive)
      return
    judges.set(Array.isArray(data) ? data : [])
    keepSnapshot(SNAPSHOT, Array.isArray(data) ? data.slice(0, 500) : [])
  }
  catch (err) {
    if (!alive)
      return
    failed.set(true)
    offline.set((err as any)?.status === 0)
  }
  finally {
    if (alive)
      loading.set(false)
  }
}

function typed(value: string): void {
  term.set(value)
  // Back to page 1: a narrower result has fewer pages, and staying on page 9
  // of a two-page answer shows nothing at all.
  currentPage.set(1)
}

function clear(): void {
  term.set('')
  currentPage.set(1)
}

function open(judge: Judge): void {
  // `open(path)` and nothing else: Craft's navigation takes a path string and
  // throws on anything else, so a screen cannot be handed the row the list
  // already holds. The detail screen fetches by id, which is why
  // GET /api/judges/{id} exists.
  craft?.navigation?.open(`/judges/${judge.id}`)
}

async function refresh(): Promise<void> {
  await load()
}

onMount(() => {
  alive = true
  void load()
  return () => { alive = false }
})
</script>

<template>
  <View :class="ui.screen">
    <ScrollView class="flex-1" @refresh="refresh()" :refreshing="loading() && judges().length > 0" keyboardDismissMode="on-drag">
      <View class="mt-2" :class="ui.search">
        <Icon name="search" class="h-4 w-4 text-[#8e8e93]" />
        <TextInput
          class="flex-1 text-[17px] text-black dark:text-white border-0"
          :value="term()"
          @input="typed($event.text)"
          returnKeyType="search"
          autoCapitalize="none"
          :autoCorrect="false"
          placeholder="Search by name, court, or location"
          placeholderTextColor="#8e8e93"
          accessibilityLabel="Search judges"
          testID="judges-search"
        />
        <Pressable :if="term().length > 0" id="judges-clear" @press="clear()" accessibilityRole="button" accessibilityLabel="Clear search" testID="judges-clear">
          <Icon name="circle-x" class="h-4 w-4 text-[#8e8e93]" />
        </Pressable>
      </View>

      <Text :if="summary()" :class="ui.header" :text="summary()" testID="judges-summary" />

      <View :if="rows().length > 0" :class="ui.group" testID="judges-list">
        <View :for="(row, index) in rows()" :key="row.key">
          <View :if="index" :class="ui.separatorAvatar" />
          {{-- Pressable, not a View with @click. A View is not a tap target in
              the native renderer — the row rendered correctly and simply did
              nothing when tapped. --}}
          <Pressable
            :id="'judge-' + row.key"
            @press="open(row.judge)"
            class="flex-row gap-3 items-center px-4 py-2.5"
            accessibilityRole="button"
            :accessibilityLabel="row.name"
            :testID="'judge-' + row.key"
          >
            <Image :if="row.photo" :source="{ uri: row.photo }" resizeMode="cover" class="h-11 w-11 rounded-full" :accessibilityLabel="row.name" />
            <View :if="!row.photo" :class="ui.avatar">
              <Text :class="ui.avatarText" :text="row.mark" />
            </View>
            <View class="flex-1">
              <Text :numberOfLines="1" :class="ui.title" :text="row.name" />
              <Text :if="row.where" :numberOfLines="1" :class="ui.subtitle" :text="row.where" />
            </View>
            <Icon name="chevron-right" :class="ui.chevron" />
          </Pressable>
        </View>
      </View>

      {{-- Three rows in the shape the answer will have, rather than a spinner. --}}
      <View :if="showSkeleton()" class="mt-7" :class="ui.group" testID="judges-loading">
        <View :for="n in [1, 2, 3]" :key="n" class="flex-row gap-3 items-center px-4 py-3">
          <View class="h-11 w-11" :class="ui.skeleton" />
          <View class="flex-1 gap-2">
            <View class="h-3.5 w-1/2" :class="ui.skeleton" />
            <View class="h-3 w-1/3" :class="ui.skeleton" />
          </View>
        </View>
      </View>

      <View :if="nothing()" class="items-center mt-7 py-6" :class="ui.card" accessibilityRole="alert" testID="judges-empty">
        <Icon :name="offline() ? 'wifi-off' : 'search'" class="h-7 w-7 text-[#c7c7cc] dark:text-[#48484a]" />
        <Text class="mt-3 text-center" :class="ui.subtitle" :text="reason()" />
        <Pressable :if="failed()" id="judges-retry" @press="refresh()" class="justify-center mt-2 min-h-[44px]" accessibilityRole="button" testID="judges-retry">
          <Text class="text-[17px]" :class="ui.tint" text="Try again" />
        </Pressable>
      </View>


      {{-- Prev / 1 2 … N / Next, the same pager the web directory draws. The
          page pills sit in a `:for`, and a tap handler that references the
          loop variable is the one thing not yet firing in the native runtime
          (see the note in resources/native/Judges.stx), so Prev and Next —
          which reference nothing from a loop — are the controls that are
          known to work today. --}}
      <View :if="lastPage() > 1" class="flex-row gap-2 items-center justify-center mb-10 mt-6" testID="judges-pager">
        <Pressable id="judges-prev" @press="prevPage()" class="justify-center px-3 min-h-[44px]" accessibilityRole="button" accessibilityLabel="Previous page" testID="judges-prev">
          <Text class="text-[17px]" :class="currentPage() > 1 ? ui.tint : ui.caption" text="Prev" />
        </Pressable>

        <View :for="item in pages()" :key="item.label + '-' + item.n">
          <Text :if="item.gap" :class="ui.caption" text="…" />
          <Pressable :if="!item.gap" :id="'judges-page-' + item.label" @press="goToPage(item.n)" class="items-center justify-center px-3 min-h-[44px] rounded-[8px]" :class="item.active ? 'bg-[#2563eb]' : ''" accessibilityRole="button" :accessibilityLabel="'Page ' + item.label" :testID="'judges-page-' + item.label">
            <Text class="text-[17px]" :class="item.active ? 'font-semibold text-white' : ui.tint" :text="item.label" />
          </Pressable>
        </View>

        <Pressable id="judges-next" @press="nextPage()" class="justify-center px-3 min-h-[44px]" accessibilityRole="button" accessibilityLabel="Next page" testID="judges-next">
          <Text class="text-[17px]" :class="currentPage() < lastPage() ? ui.tint : ui.caption" text="Next" />
        </Pressable>
      </View>

      <View class="h-12" />
    </ScrollView>
  </View>
</template>
