<script client lang="ts">
// One judge's education, drawn natively (config/mobile.ts `nativeScreens`,
// /judges/:id/education): the phone's half of the profile tab's education
// list in Bench/Judge/Profile.stx.
//
// GET /api/judges/{id}/education answers `{ education: [...] }` — the whole
// history, which is a handful of entries, so there is nothing to paginate.
// It never errors: an unknown judge or a malformed column both come back as
// an empty list rather than a 500, so "none recorded" is the only empty
// state this screen needs besides being offline.
import { ApiError, getJson } from '../functions/native-api'
import { JUDGE_FIELDS, handoffFromParams } from '../functions/native-handoff'
import { ui } from '../functions/native-ui'

interface EducationEntry {
  degree?: string | null
  school?: string | null
  year?: string | null
}

const craft = (globalThis as any).craft

function readJudgeId(): number {
  const route = craft?.route ?? {}
  const fromParams = Number(route.params?.id ?? 0)
  if (Number.isInteger(fromParams) && fromParams > 0)
    return fromParams
  const fromPath = String(route.path ?? '').match(/\/judges\/(\d+)/)
  return fromPath ? Number(fromPath[1]) : 0
}

const judgeId = state<number>(readJudgeId())
const judgeName = state<string>(handoffFromParams<any>(craft?.route?.params, JUDGE_FIELDS)?.name ?? '')

const entries = state<EducationEntry[]>([])
const loading = state(true)
const failed = state(false)
const offline = state(false)

let alive = true

const rows = derived(() => entries().map((e, index) => ({
  key: `${index}-${e.school ?? ''}`,
  // The degree is the heading; a record with only a school still reads as
  // one rather than showing a blank line above it.
  degree: e.degree || e.school || 'Education',
  // The school goes under it, and only when it is not already the heading.
  school: e.degree ? (e.school || '') : '',
  year: e.year || '',
})))

const nothing = derived<boolean>(() => !loading() && (failed() || !entries().length))

const countLine = derived<string>(() => {
  const n = entries().length
  if (!n)
    return ''
  return n === 1 ? '1 ENTRY' : `${n} ENTRIES`
})

const reason = derived<string>(() => {
  if (offline())
    return 'Education needs a connection. Reconnect and try again.'
  if (failed())
    return 'The education history could not be loaded.'
  // About half the judges in the directory have no CourtListener record —
  // the site deliberately shows nothing rather than inventing a degree.
  return 'No education history is recorded for this judge.'
})

const title = derived<string>(() => judgeName() ? `${judgeName()} · Education` : 'Education')

effect(() => craft?.navigation?.setOptions({ title: title() }))

async function load(): Promise<void> {
  const id = judgeId()
  if (!id) {
    loading.set(false)
    failed.set(true)
    return
  }
  failed.set(false)
  offline.set(false)
  try {
    const body = await getJson<{ education?: EducationEntry[] }>(`/api/judges/${id}/education`)
    if (!alive)
      return
    entries.set(Array.isArray(body?.education) ? body.education : [])
  }
  catch (err) {
    if (!alive)
      return
    failed.set(true)
    offline.set(err instanceof ApiError && err.status === 0)
  }
  finally {
    if (alive)
      loading.set(false)
  }
}

async function refresh(): Promise<void> {
  await load()
}

onMount(() => {
  alive = true
  void load()
  return () => { alive = false }
})
</script>

<template>
  <View :class="ui.screen">
    <ScrollView class="flex-1" @refresh="refresh()" :refreshing="loading() && entries().length > 0">
      <Text :if="countLine()" :class="ui.header" :text="countLine()" testID="education-count" />

      <View :if="rows().length > 0" :class="ui.group" testID="education-list">
        <View :for="(row, index) in rows()" :key="row.key">
          <View :if="index" :class="ui.separator" />
          <View class="flex-row gap-3 items-center px-4 py-2.5 min-h-[44px]">
            <View class="flex-1">
              <Text :class="ui.title" :text="row.degree" />
              <Text :if="row.school" :class="ui.subtitle" :text="row.school" />
            </View>
            <Text :if="row.year" :class="ui.value" :text="row.year" />
          </View>
        </View>
      </View>

      <View :if="loading() && !entries().length" class="mt-7" :class="ui.group" testID="education-loading">
        <View :for="n in [1, 2]" :key="n" class="gap-2 px-4 py-3.5">
          <View class="h-3.5 w-1/2" :class="ui.skeleton" />
          <View class="h-3 w-2/3" :class="ui.skeleton" />
        </View>
      </View>

      <View :if="nothing()" class="items-center mt-7 py-6" :class="ui.card" accessibilityRole="alert" testID="education-empty">
        <Icon :name="offline() ? 'wifi-off' : 'graduation-cap'" class="h-7 w-7 text-[#c7c7cc] dark:text-[#48484a]" />
        <Text class="mt-3 text-center" :class="ui.subtitle" :text="reason()" />
        <Pressable :if="failed()" id="education-retry" @press="refresh()" class="justify-center mt-2 min-h-[44px]" accessibilityRole="button" testID="education-retry">
          <Text class="text-[17px]" :class="ui.tint" text="Try again" />
        </Pressable>
      </View>

      <View class="h-10" />
    </ScrollView>
  </View>
</template>
