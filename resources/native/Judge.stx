<script client lang="ts">
// One judge, drawn natively (config/mobile.ts `nativeScreens`,
// /judges/:id): the phone's half of Bench/Judge/ProfileHeader.stx and its
// reviews tab.
//
// The judge itself arrives as the pushed route's props — Judges.stx hands
// over the row it already has — because there is no GET /api/judges/{id} to
// call. Opening a judge is therefore instant and works offline for anything
// already listed. Only the reviews are fetched, from the same public endpoint
// the website uses.
import { ApiError, getJson } from '../functions/native-api'
import { handoffFromParams, handoffQuery, JUDGE_FIELDS, judgeFromHandoff } from '../functions/native-handoff'
import { commentLabel, helpfulLabel, nextLikeState, sendLike } from '../functions/native-reactions'
import { plainTextFromHtml, shortDate, starsFor } from '../functions/native-review'
import { signedIn } from '../functions/native-session'
import { initials, ui } from '../functions/native-ui'

interface Review {
  id: number
  title?: string | null
  content?: string | null
  rating?: number | null
  created_at?: string | null
  reviewer?: { name?: string | null, role_label?: string | null } | null
  likes?: number | null
  liked_by_me?: boolean | null
  comments?: number | null
  /** The endpoint strips `user_id` and states ownership instead. */
  is_mine?: boolean | null
}

const craft = (globalThis as any).craft

/**
 * The judge this screen is for.
 *
 * `craft.route.params` — NOT `craft.navigation.route`, which is undefined and
 * is why this screen first rendered as a bare "Judge" with a `?` avatar.
 *
 * Params can also arrive AFTER the first render: the runtime exposes
 * `route.onParams` precisely because the screen can be constructed before its
 * route is resolved. Reading once at the top of the script is therefore not
 * enough, and the subscription below re-reads when they land.
 *
 * `route.path` is the fallback — the id is in the URL either way, and a
 * detail screen that cannot name its own subject is useless.
 */
function readJudgeId(): number {
  const route = craft?.route ?? {}
  const fromParams = Number(route.params?.id ?? 0)
  if (Number.isInteger(fromParams) && fromParams > 0)
    return fromParams
  const fromPath = String(route.path ?? '').match(/\/judges\/(\d+)/)
  return fromPath ? Number(fromPath[1]) : 0
}

const judgeId = state<number>(readJudgeId())

/**
 * The judge, painted from whatever the opener put in the URL.
 *
 * Read synchronously as the initial state rather than in `onMount`, so the
 * header is right in the FIRST frame — an effect that fills it a tick later
 * still shows a blank name and a "?" avatar for that tick, which is the
 * flicker this exists to remove.
 *
 * The handoff travels with this navigation, so it cannot be stale and cannot
 * belong to another judge; see native-handoff.ts for the two store-shaped
 * designs that could be both. A cold deep link carries no handoff and falls
 * back to the fetch, which is why GET /api/judges/{id} still exists.
 */
const judge = state<Record<string, any> | null>(judgeFromHandoff(handoffFromParams(craft?.route?.params, JUDGE_FIELDS)))
const reviews = state<Review[]>([])
const loading = state(true)
const failed = state(false)
const offline = state(false)
/** Optimistic likes, keyed by review — see Reviews.stx for why beside. */
const reactions = state<Record<number, { liked: boolean, likes: number }>>({})
/** A refusal to report, cleared by the next thing the person does. */
const notice = state('')

let alive = true

const name = derived<string>(() => judge()?.name || 'Judge')
const mark = derived<string>(() => initials(judge()?.name))
const photo = derived<string>(() => judge()?.photo || '')
const court = derived<string>(() => judge()?.court?.name || '')
const where = derived<string>(() => judge()?.location || '')

const rows = derived(() => reviews().map((r) => {
  const pending = reactions()[r.id]
  const liked = pending ? pending.liked : Boolean(r.liked_by_me)
  const likes = pending ? pending.likes : Number(r.likes ?? 0)
  const comments = Number(r.comments ?? 0)
  return {
  key: r.id,
  liked,
  likes,
  comments,
  helpfulText: helpfulLabel(likes),
  commentText: commentLabel(comments),
  mine: Boolean(r.is_mine),
  title: r.title || 'Untitled review',
  // The API returns sanitized HTML; a native Text draws characters, not
  // markup. This used to strip tags with a local regex, which left the
  // ENTITIES behind — a review mentioning "Smith & Co" rendered as
  // "Smith &amp; Co". `plainTextFromHtml` decodes them, and sharing it with
  // the feed stops the two screens drifting again.
  body: plainTextFromHtml(r.content || ''),
  // Hollow stars for the remainder, as in the feed: a bare "★★" does not say
  // out of how many.
  stars: starsFor(r.rating),
  who: [r.reviewer?.name || 'Reviewer', shortDate(r.created_at)].filter(Boolean).join(' · '),
  }
}))

const summary = derived<string>(() => {
  if (loading())
    return ''
  const n = reviews().length
  return n === 1 ? '1 review' : `${n} reviews`
})

const reason = derived<string>(() => {
  if (offline())
    return 'Could not reach Bench Review. Reviews will load when you are back online.'
  if (failed())
    return 'The reviews could not be loaded.'
  return 'No reviews of this judge yet.'
})

const nothing = derived<boolean>(() => !loading() && (failed() || !reviews().length))

effect(() => craft?.navigation?.setOptions({ title: name() }))

async function load(): Promise<void> {
  const id = judgeId()
  if (!id) {
    loading.set(false)
    failed.set(true)
    return
  }
  failed.set(false)
  offline.set(false)
  try {
    // Both in flight together: the header and the reviews are independent, so
    // serialising them would show an empty screen for two round trips.
    //
    // `allSettled`, not `all`: with `all` a failing REVIEWS request threw away
    // a perfectly good judge, so a judge whose reviews endpoint was down had
    // no name and a "?" avatar. They fail independently because they are
    // independent.
    const [who, data] = await Promise.allSettled([
      getJson<Record<string, any>>(`/api/judges/${id}`),
      getJson<{ data?: Review[] } | Review[]>(`/api/judges/${id}/reviews?page=1&per_page=20`),
    ])
    if (!alive)
      return

    if (who.status === 'fulfilled')
      judge.set(who.value)

    if (data.status === 'fulfilled') {
      const body = data.value
      reviews.set(Array.isArray(body) ? body : (body?.data ?? []))
      // The new rows carry the server's own counts, so a guess still being
      // held is both stale and redundant.
      reactions.set({})
    }

    // Only the reviews decide the failed state: this screen's empty card is
    // about reviews, and the header speaks for itself once it is painted.
    if (data.status === 'rejected') {
      failed.set(true)
      offline.set(data.reason instanceof ApiError && data.reason.status === 0)
    }
  }
  catch (err) {
    if (!alive)
      return
    failed.set(true)
    offline.set(err instanceof ApiError && err.status === 0)
  }
  finally {
    if (alive)
      loading.set(false)
  }
}

async function refresh(): Promise<void> {
  await load()
}

/**
 * The judge's opinions and education, each its own screen.
 *
 * The name rides along so the pushed screen's title is right in the first
 * frame rather than reading "Opinions" until something loads.
 */
/**
 * Mark a review helpful, or take it back.
 *
 * The same rows as the feed, so the same behaviour: optimistic, with the
 * server's answer replacing the guess and a refusal putting the old value
 * back. `sendLike` owns the request and the wording for both screens — these
 * two have drifted once already, when this one stripped tags with its own
 * regex and printed `Smith &amp; Co` for it.
 */
async function toggleLike(row: { key: number, liked: boolean, likes: number }): Promise<void> {
  if (!signedIn()) {
    craft?.navigation?.open?.('/login')
    return
  }

  const before = { liked: row.liked, likes: row.likes }
  reactions.set({ ...reactions(), [row.key]: nextLikeState(before) })
  notice.set('')

  const outcome = await sendLike(row.key, before)
  if (!alive)
    return
  // The value is the server's on success and the previous one on failure, so
  // applying it unconditionally IS the rollback.
  reactions.set({ ...reactions(), [row.key]: outcome.value })
  if (outcome.error)
    notice.set(outcome.error)
}

/** Open the thread, handing over what this row already knows. */
function openComments(row: { key: number, title: string, comments: number }): void {
  if (!row.key)
    return
  notice.set('')
  craft?.navigation?.open?.(`/reviews/${row.key}/comments${handoffQuery({
    title: row.title,
    judge: name(),
    comments: row.comments,
  })}`)
}

function openSection(section: string): void {
  const id = judgeId()
  if (!id)
    return
  craft?.navigation?.open?.(`/judges/${id}/${section}${handoffQuery({ name: name() })}`)
}

/**
 * Write a review of this judge.
 *
 * `/review/:id` rather than the Write tab, so the judge is already chosen —
 * someone who got here by reading about a judge should not have to find them
 * again in a picker. `open(path)` is the only shape Craft's navigation takes.
 */
function review(): void {
  const id = judgeId()
  if (id)
    craft?.navigation?.open?.(`/review/${id}`)
}

onMount(() => {
  alive = true
  void load()

  // Params that resolve after construction: re-read and fetch again, but only
  // when the id actually changed, so this cannot loop.
  try {
    craft?.route?.onParams?.(() => {
      const next = readJudgeId()
      if (next && next !== judgeId()) {
        judgeId.set(next)
        void load()
      }
    })
  }
  catch {
    // No subscription on this runtime; the initial read stands.
  }

  return () => { alive = false }
})
</script>

<template>
  <View :class="ui.screen">
    <ScrollView class="flex-1" @refresh="refresh()" :refreshing="loading() && reviews().length > 0">
      {{-- Who this is. Drawn from the row handed over by the directory, so it
          is on screen in the first frame with no request. --}}
      <View class="items-center mt-6" testID="judge-header">
        <Image :if="photo()" :source="{ uri: photo() }" resizeMode="cover" class="h-20 w-20 rounded-full" :accessibilityLabel="name()" />
        <View :if="!photo()" class="items-center justify-center h-20 w-20 bg-[#2563eb] dark:bg-[#1d4ed8] rounded-full">
          <Text class="font-semibold text-[28px] text-white" :text="mark()" />
        </View>
        <Text class="mt-3 font-semibold text-[22px] text-black text-center dark:text-white" :text="name()" />
        <Text :if="court()" class="mt-1 text-center" :class="ui.subtitle" :text="court()" />
        <Text :if="where()" class="mt-0.5 text-center" :class="ui.caption" :text="where()" />
      </View>

      <Pressable
        id="judge-write-review"
        @press="review()"
        class="items-center justify-center mt-6 mx-4 h-[50px] bg-[#2563eb] dark:bg-[#1d4ed8] rounded-[12px]"
        accessibilityRole="button"
        accessibilityLabel="Write a review of this judge"
        testID="judge-write-review"
      >
        <Text class="font-semibold text-[17px] text-white" text="Write a review" />
      </Pressable>

      {{-- Two more surfaces for this judge. Shown unconditionally rather than
           gated on a count: learning whether either has rows costs two more
           requests on a screen that already makes two, and each screen says
           plainly when it has nothing. --}}
      <View class="mt-6" :class="ui.group" testID="judge-sections">
        <Pressable id="judge-opinions" @press="openSection('opinions')" :class="ui.row" accessibilityRole="button" accessibilityLabel="Opinions" testID="judge-opinions">
          <Icon name="scale" class="h-5 w-5" :class="ui.tint" />
          <Text class="flex-1" :class="ui.title" text="Opinions" />
          <Icon name="chevron-right" :class="ui.chevron" />
        </Pressable>
        <View :class="ui.separator" />
        <Pressable id="judge-education" @press="openSection('education')" :class="ui.row" accessibilityRole="button" accessibilityLabel="Education" testID="judge-education">
          <Icon name="graduation-cap" class="h-5 w-5" :class="ui.tint" />
          <Text class="flex-1" :class="ui.title" text="Education" />
          <Icon name="chevron-right" :class="ui.chevron" />
        </Pressable>
      </View>

      <Text :if="summary()" :class="ui.header" :text="summary()" testID="judge-reviews-summary" />

      <View :if="notice()" class="mb-2 mx-4 px-3 py-2 bg-[#fff0f0] dark:bg-[#2c1618] rounded-[10px]" testID="judge-notice">
        <Text :class="ui.danger" :text="notice()" />
      </View>

      <View :if="rows().length > 0" :class="ui.group" testID="judge-reviews">
        <View :for="(row, index) in rows()" :key="row.key">
          <View :if="index" :class="ui.separator" />
          <View class="gap-1 pb-2 pt-3 px-4">
            <View class="flex-row gap-2 items-center">
              <Text class="text-[#f59e0b] text-[15px]" :text="row.stars" />
              <Text :numberOfLines="1" class="flex-1" :class="ui.caption" :text="row.who" />
            </View>
            <Text :numberOfLines="2" :class="ui.titleStrong" :text="row.title" />
            <Text :if="row.body" :numberOfLines="3" :class="ui.subtitle" :text="row.body" />
          </View>

          <!--
            The same chips as the feed, because these are the same rows. A
            review that can be marked helpful in one place and not the other
            is the kind of difference people notice and cannot explain.

            Nothing here is nested inside a Pressable: this row has none, and
            adding one later would make these a coin toss over which handler
            runs — see Reviews.stx.
          -->
          <View class="flex-row gap-2 items-center pb-3 px-4" :testID="'judge-review-actions-' + row.key">
            <Pressable
              :if="!row.mine"
              :id="'judge-review-like-' + row.key"
              @press="toggleLike(row)"
              class="flex-row gap-1.5 items-center px-4 min-h-[44px] rounded-full"
              :class="row.liked ? 'bg-[#2563eb]' : 'bg-[#f2f2f7] dark:bg-[#2c2c2e]'"
              accessibilityRole="button"
              :accessibilityState="{ selected: row.liked }"
              :accessibilityLabel="row.liked ? 'Marked helpful. Tap to undo' : 'Mark this review helpful'"
              :testID="'judge-review-like-' + row.key"
            >
              <Icon name="thumbs-up" class="h-[17px] w-[17px]" :class="row.liked ? 'text-white' : 'text-[#6e6e73] dark:text-[#98989d]'" />
              <Text :class="row.liked ? 'font-semibold text-[15px] text-white' : 'text-[15px] text-[#3c3c43] dark:text-[#d1d1d6]'" :text="row.helpfulText" />
            </Pressable>

            <Pressable
              :id="'judge-review-comments-' + row.key"
              @press="openComments(row)"
              class="flex-row gap-1.5 items-center px-4 min-h-[44px] bg-[#f2f2f7] dark:bg-[#2c2c2e] rounded-full"
              accessibilityRole="button"
              :accessibilityLabel="'Comments on ' + row.title"
              :testID="'judge-review-comments-' + row.key"
            >
              <Icon name="message-square" class="h-[17px] w-[17px] text-[#6e6e73] dark:text-[#98989d]" />
              <Text class="text-[#3c3c43] text-[15px] dark:text-[#d1d1d6]" :text="row.commentText" />
            </Pressable>
          </View>
        </View>
      </View>

      <View :if="loading() && !reviews().length" class="mt-7" :class="ui.group" testID="judge-loading">
        <View :for="n in [1, 2]" :key="n" class="gap-2 px-4 py-4">
          <View class="h-3.5 w-1/3" :class="ui.skeleton" />
          <View class="h-3 w-2/3" :class="ui.skeleton" />
        </View>
      </View>

      <View :if="nothing()" class="items-center mt-7 py-6" :class="ui.card" accessibilityRole="alert" testID="judge-empty">
        <Icon :name="offline() ? 'wifi-off' : 'message-square'" class="h-7 w-7 text-[#c7c7cc] dark:text-[#48484a]" />
        <Text class="mt-3 text-center" :class="ui.subtitle" :text="reason()" />
        <Pressable :if="failed()" id="judge-retry" @press="refresh()" class="justify-center mt-2 min-h-[44px]" accessibilityRole="button" testID="judge-retry">
          <Text class="text-[17px]" :class="ui.tint" text="Try again" />
        </Pressable>
      </View>

      <View class="h-12" />
    </ScrollView>
  </View>
</template>
