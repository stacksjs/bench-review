<script client lang="ts">
// The review feed, drawn natively (config/mobile.ts `nativeScreens`,
// /reviews): the phone's half of Bench/ReviewsFeed.stx.
//
// Published reviews across every judge, newest first, with the same
// recent/helpful sort the web feed offers. Public — no session needed, same
// as the directories, because reading reviews is the point of the site.
//
// A row opens the JUDGE, not a review page. That is what the web feed does
// (`/judges/:id/profile`), there is no standalone review screen on either
// surface, and the judge screen already lists their reviews.
import { ApiError, getJson, keepSnapshot, readSnapshot } from '../functions/native-api'
import { handoffQuery } from '../functions/native-handoff'
import { buildPages } from '../functions/native-paging'
import { commentLabel, helpfulLabel, nextLikeState, sendLike } from '../functions/native-reactions'
import { plainTextFromHtml, shortDate, starsFor } from '../functions/native-review'
import { signedIn, viewerHeaders } from '../functions/native-session'
import { ui } from '../functions/native-ui'

interface FeedReview {
  id: number
  title?: string | null
  content?: string | null
  rating?: number | null
  created_at?: string | null
  judge_id?: number | null
  judge?: { id?: number, name?: string | null, context_line?: string | null, image_url?: string | null } | null
  reviewer?: { name?: string | null } | null
  likes?: number | null
  liked_by_me?: boolean | null
  comments?: number | null
  /** The endpoint strips `user_id` and states ownership instead. */
  is_mine?: boolean | null
}

interface FeedPage {
  data?: FeedReview[]
  current_page?: number
  last_page?: number
  total?: number
}

const craft = (globalThis as any).craft
const SNAPSHOT = 'reviews-feed'
const PER_PAGE = 20

const reviews = state<FeedReview[]>(readSnapshot<FeedReview[]>(SNAPSHOT) ?? [])
const currentPage = state<number>(1)
const lastPage = state<number>(1)
const total = state<number>(0)
const sort = state<string>('recent')
const loading = state(true)
const failed = state(false)
const offline = state(false)
/**
 * Where an optimistic like lives until the server answers, keyed by review.
 *
 * Kept BESIDE the feed rather than written into them: a page reload replaces
 * `reviews` wholesale, and an override map keyed by id simply stops matching
 * — which is the behaviour wanted, since the fresh rows carry the server's
 * own count by then.
 */
const reactions = state<Record<number, { liked: boolean, likes: number }>>({})
/** A refusal to report, cleared by the next thing the person does. */
const notice = state('')

let alive = true
// Guards against an older page landing after a newer one and overwriting it
// — two taps on Next in quick succession are enough.
let request = 0

const rows = derived(() => reviews().map((r) => {
  const pending = reactions()[r.id]
  const liked = pending ? pending.liked : Boolean(r.liked_by_me)
  const likes = pending ? pending.likes : Number(r.likes ?? 0)
  const comments = Number(r.comments ?? 0)
  return {
  review: r,
  key: r.id,
  liked,
  likes,
  comments,
  helpfulText: helpfulLabel(likes),
  commentText: commentLabel(comments),
  // Authors cannot react to their own work — the server answers 422 — so the
  // button is not offered rather than offered and refused.
  mine: Boolean(r.is_mine),
  judgeId: Number(r.judge?.id ?? r.judge_id ?? 0),
  stars: starsFor(r.rating),
  title: r.title || 'Untitled review',
  snippet: plainTextFromHtml(r.content || ''),
  judgeName: r.judge?.name || 'Unknown judge',
  where: r.judge?.context_line || '',
  // `image_url` here, `photo` on the judge endpoint — the feed composes its
  // judge from `attachJudgeContext`, which keeps the column's own name. The
  // handoff translates, so the detail screen only ever reads `photo`.
  judgePhoto: r.judge?.image_url || '',
  byline: [r.reviewer?.name || 'Anonymous reviewer', shortDate(r.created_at)].filter(Boolean).join(' · '),
  }
}))

const pages = derived(() => buildPages(currentPage(), lastPage()))
const nothing = derived<boolean>(() => !loading() && !reviews().length)
const showSkeleton = derived<boolean>(() => loading() && !reviews().length)

const countLine = derived<string>(() => {
  const n = total()
  if (!n)
    return ''
  return n === 1 ? '1 REVIEW' : `${n} REVIEWS`
})

const reason = derived<string>(() => {
  if (offline())
    return 'The feed needs a connection. Reconnect and try again.'
  if (failed())
    return 'The feed could not be loaded. This is a problem on our side.'
  return 'No reviews have been published yet. The first one could be yours.'
})

effect(() => craft?.navigation?.setOptions({ title: 'Feed', largeTitle: true }))

/**
 * One page of the feed.
 *
 * Paged on the SERVER, unlike the directories: the feed is unbounded and
 * grows, so pulling it whole to page in memory would get slower every week.
 * That makes a page change a request, which is why the stale-response guard
 * above exists.
 */
async function load(page: number): Promise<void> {
  const ticket = ++request
  loading.set(true)
  failed.set(false)
  offline.set(false)
  try {
    const body = await getJson<FeedPage>(`/api/reviews?page=${page}&per_page=${PER_PAGE}&sort=${sort()}`, undefined, viewerHeaders())
    if (!alive || ticket !== request)
      return
    const data = Array.isArray(body?.data) ? body.data : []
    reviews.set(data)
    // The new rows carry the server's own counts, so any guess still being
    // held is now both stale and redundant.
    reactions.set({})
    currentPage.set(Number(body?.current_page ?? page) || 1)
    lastPage.set(Math.max(1, Number(body?.last_page ?? 1)))
    total.set(Number(body?.total ?? data.length) || 0)
    // Only page one is worth keeping: it is what a cold start shows.
    if (page === 1)
      keepSnapshot(SNAPSHOT, data.slice(0, PER_PAGE))
  }
  catch (err) {
    if (!alive || ticket !== request)
      return
    failed.set(true)
    offline.set((err as any)?.status === 0)
  }
  finally {
    if (alive && ticket === request)
      loading.set(false)
  }
}

function goToPage(n: number): void {
  if (n >= 1 && n <= lastPage() && n !== currentPage())
    void load(n)
}

function prevPage(): void {
  goToPage(currentPage() - 1)
}

function nextPage(): void {
  goToPage(currentPage() + 1)
}

/**
 * Change the order.
 *
 * Back to page one, because page 4 of "recent" and page 4 of "helpful" have
 * nothing to do with each other — the same reason the web feed resets.
 */
function sortBy(next: string): void {
  const value = next === 'helpful' ? 'helpful' : 'recent'
  if (sort() === value)
    return
  sort.set(value)
  void load(1)
}

/**
 * Mark a review helpful, or take it back.
 *
 * OPTIMISTIC, and it has to be: the alternative is a button that sits still
 * for a round trip, which reads as a broken button and gets tapped again.
 * The server's own answer replaces the guess, and a refusal puts the old
 * state back — a count that stayed wrong would be worse than one that never
 * moved, because nothing on screen would say so.
 *
 * Signed out, this is not an error. The endpoint is auth-gated for good
 * reason (a single person could otherwise spam the counter by reloading), so
 * the honest response to a tap is to offer the sign-in rather than to explain
 * a refusal.
 */
async function toggleLike(row: { key: number, liked: boolean, likes: number }): Promise<void> {
  if (!signedIn()) {
    craft?.navigation?.open?.('/login')
    return
  }

  const before = { liked: row.liked, likes: row.likes }
  setReaction(row.key, nextLikeState(before))
  notice.set('')

  const outcome = await sendLike(row.key, before)
  if (!alive)
    return
  // `outcome.value` is the server's answer on success and the previous value
  // on failure, so applying it unconditionally IS the rollback.
  setReaction(row.key, outcome.value)
  if (outcome.error)
    notice.set(outcome.error)
}

function setReaction(id: number, value: { liked: boolean, likes: number }): void {
  reactions.set({ ...reactions(), [id]: value })
}

/**
 * Open the thread under a review.
 *
 * The count rides along so the screen's header is finished in frame one,
 * the same way a judge row hands its judge over.
 */
function openComments(row: { key: number, title: string, judgeName: string, comments: number }): void {
  if (!row.key)
    return
  notice.set('')
  craft?.navigation?.open?.(`/reviews/${row.key}/comments${handoffQuery({
    title: row.title,
    judge: row.judgeName,
    comments: row.comments,
  })}`)
}

/**
 * Open the judge, painting what this row already knows.
 *
 * Shaped like the API's judge, so the detail screen has one shape to read:
 * `context_line` is already "court · city · state" composed server-side,
 * which is what that screen's court line shows anyway, and `image_url` is
 * renamed to the `photo` the judge endpoint uses.
 *
 * Still partial — no jurisdiction or slug — but it carries everything the
 * header draws, so the first frame is the finished header rather than a
 * placeholder that is replaced a moment later.
 */
/**
 * Open the REVIEW, which is what the card is.
 *
 * It used to open the judge, while announcing itself as
 * "Review of <judge>, <title>" — a card that says one thing and does
 * another. There was no screen for a single review at the time, so the judge
 * was the only detail screen a card could reach.
 *
 * The judge is still one tap away, from the review's own screen. The name
 * stays on the card as context; it is not its own target, because a
 * Pressable inside a Pressable is a coin toss over which handler runs (see
 * the action row below).
 */
function openReview(row: { key: number, title: string, judgeName: string, stars: string, likes: number, comments: number }): void {
  if (!row.key)
    return
  notice.set('')
  craft?.navigation?.open?.(`/reviews/${row.key}${handoffQuery({
    title: row.title,
    judge: row.judgeName,
    stars: row.stars,
    likes: row.likes,
    comments: row.comments,
  })}`)
}

async function refresh(): Promise<void> {
  await load(currentPage())
}

onMount(() => {
  alive = true
  void load(1)

  // Someone leaves for the sign-in screen from a Helpful chip and comes back
  // HERE — Login pops rather than pushing on, so this tab is still mounted
  // and nothing re-runs on its own.
  //
  // What goes stale is the ROWS, not a flag on this screen: `is_mine` and
  // `liked_by_me` are computed per request from the caller's session
  // (LatestReviewsAction resolves the viewer; reviewLikes.ts fills both),
  // so a guest is served `false` for every row. Without this, after signing
  // in:
  //
  //   - your own review still offers a Helpful chip, and tapping it is a
  //     guaranteed 422 — the chip is hidden on `mine` precisely so that is
  //     never offered;
  //   - reviews you had already marked helpful read as unmarked, so the next
  //     tap takes the mark OFF something you never put it back on.
  //
  // The page is kept rather than reset to 1: coming back from a sign-in is
  // not a reason to lose someone's place in the feed.
  try {
    craft?.navigation?.onAppear?.(() => { void load(currentPage()) })
  }
  catch {
    // No appearance hook on this runtime; the mount read stands.
  }

  return () => { alive = false }
})
</script>

<template>
  <View :class="ui.screen">
    <ScrollView class="flex-1" @refresh="refresh()" :refreshing="loading() && reviews().length > 0">
      <View class="flex-row gap-2 items-center mt-2 mx-4">
        <Pressable id="reviews-sort-recent" @press="sortBy('recent')" class="items-center justify-center px-3 min-h-[44px] rounded-[8px]" :class="sort() === 'recent' ? 'bg-[#2563eb]' : ''" accessibilityRole="button" accessibilityLabel="Sort by most recent" testID="reviews-sort-recent">
          <Text :class="sort() === 'recent' ? 'text-white text-[15px]' : ui.tint" text="Recent" />
        </Pressable>
        <Pressable id="reviews-sort-helpful" @press="sortBy('helpful')" class="items-center justify-center px-3 min-h-[44px] rounded-[8px]" :class="sort() === 'helpful' ? 'bg-[#2563eb]' : ''" accessibilityRole="button" accessibilityLabel="Sort by most helpful" testID="reviews-sort-helpful">
          <Text :class="sort() === 'helpful' ? 'text-white text-[15px]' : ui.tint" text="Helpful" />
        </Pressable>
      </View>

      <Text :if="countLine()" :class="ui.header" :text="countLine()" testID="reviews-count" />

      <View :if="notice()" class="mb-2 mx-4 px-3 py-2 bg-[#fff0f0] dark:bg-[#2c1618] rounded-[10px]" testID="reviews-notice">
        <Text :class="ui.danger" :text="notice()" />
      </View>

      <View :if="rows().length > 0" :class="ui.group" testID="reviews-list">
        <View :for="(row, index) in rows()" :key="row.key">
          <View :if="index" :class="ui.separator" />
          <Pressable
            :id="'review-row-' + row.key"
            @press="openReview(row)"
            class="gap-1 pb-2 pt-3 px-4"
            accessibilityRole="button"
            :accessibilityLabel="'Review of ' + row.judgeName + ', ' + row.title"
            :testID="'review-row-' + row.key"
          >
            <View class="flex-row gap-2 items-center">
              <Text class="text-[#f59e0b] text-[15px]" :text="row.stars" />
              <Text :numberOfLines="1" class="flex-1" :class="ui.caption" :text="row.byline" />
            </View>
            <Text :numberOfLines="2" :class="ui.titleStrong" :text="row.title" />
            <Text :if="row.snippet" :numberOfLines="3" :class="ui.subtitle" :text="row.snippet" />
            <View class="flex-row gap-1 items-center mt-0.5">
              <Text :numberOfLines="1" :class="ui.tint" :text="row.judgeName" />
              <Text :if="row.where" :numberOfLines="1" class="flex-1" :class="ui.caption" :text="'· ' + row.where" />
            </View>
          </Pressable>

          <!--
            The action row is a SIBLING of the row's own Pressable, never a
            child of it. A Pressable inside a Pressable is a coin toss over
            which handler runs, and the losing side fails the way every missed
            press on this platform fails: silently, with the screen simply
            staying put.

            They are CHIPS rather than bare icons: a filled pill reads as
            something you press, where a glyph and a number sitting under a
            paragraph read as part of the paragraph. Pressed fills with the
            tint and the glyph goes white — the same vocabulary as the
            Recent/Helpful sort at the top of this screen.

            Pressed state is not carried by colour alone: the label changes
            with it, `accessibilityState` marks it selected, and the
            `accessibilityLabel` says which action a tap performs. Colour-only
            state is what the review form was pulled up on (bench-review#58).

            There is no "not helpful". `judge_reviews_likes` holds one row per
            like with no direction, so a second button could only clear the
            first — a control that lies about what it does. Yelp's votes are
            all positive for the same reason, and Amazon dropped its downvote
            years ago.
          -->
          <View class="flex-row gap-2 items-center pb-3 px-4" :testID="'review-actions-' + row.key">
            <Pressable
              :if="!row.mine"
              :id="'review-like-' + row.key"
              @press="toggleLike(row)"
              class="flex-row gap-1.5 items-center px-4 min-h-[44px] rounded-full"
              :class="row.liked ? 'bg-[#2563eb]' : 'bg-[#f2f2f7] dark:bg-[#2c2c2e]'"
              accessibilityRole="button"
              :accessibilityState="{ selected: row.liked }"
              :accessibilityLabel="row.liked ? 'Marked helpful. Tap to undo' : 'Mark this review helpful'"
              :testID="'review-like-' + row.key"
            >
              <Icon name="thumbs-up" class="h-[17px] w-[17px]" :class="row.liked ? 'text-white' : 'text-[#6e6e73] dark:text-[#98989d]'" />
              <Text :class="row.liked ? 'font-semibold text-[15px] text-white' : 'text-[15px] text-[#3c3c43] dark:text-[#d1d1d6]'" :text="row.helpfulText" />
            </Pressable>

            <Pressable
              :id="'review-comments-' + row.key"
              @press="openComments(row)"
              class="flex-row gap-1.5 items-center px-4 min-h-[44px] bg-[#f2f2f7] dark:bg-[#2c2c2e] rounded-full"
              accessibilityRole="button"
              :accessibilityLabel="'Comments on ' + row.title"
              :testID="'review-comments-' + row.key"
            >
              <Icon name="message-square" class="h-[17px] w-[17px] text-[#6e6e73] dark:text-[#98989d]" />
              <Text class="text-[#3c3c43] text-[15px] dark:text-[#d1d1d6]" :text="row.commentText" />
            </Pressable>
          </View>
        </View>
      </View>

      <View :if="showSkeleton()" class="mt-7" :class="ui.group" testID="reviews-loading">
        <View :for="n in [1, 2, 3]" :key="n" class="gap-2 px-4 py-4">
          <View class="h-3 w-1/4" :class="ui.skeleton" />
          <View class="h-3.5 w-2/3" :class="ui.skeleton" />
          <View class="h-3 w-full" :class="ui.skeleton" />
        </View>
      </View>

      <View :if="nothing()" class="items-center mt-7 py-6" :class="ui.card" accessibilityRole="alert" testID="reviews-empty">
        <Icon :name="offline() ? 'wifi-off' : 'message-square'" class="h-7 w-7 text-[#c7c7cc] dark:text-[#48484a]" />
        <Text class="mt-3 text-center" :class="ui.subtitle" :text="reason()" />
        <Pressable :if="failed()" id="reviews-retry" @press="refresh()" class="justify-center mt-2 min-h-[44px]" accessibilityRole="button" testID="reviews-retry">
          <Text class="text-[17px]" :class="ui.tint" text="Try again" />
        </Pressable>
      </View>

      <View :if="pages().length" class="flex-row items-center justify-center mb-10 mt-4">
        <Pressable id="reviews-prev" @press="prevPage()" class="justify-center px-3 min-h-[44px]" accessibilityRole="button" accessibilityLabel="Previous page" testID="reviews-prev">
          <Text :class="currentPage() > 1 ? ui.tint : ui.caption" text="Prev" />
        </Pressable>
        <View :for="item in pages()" :key="item.label + '-' + item.n">
          <Text :if="item.gap" class="px-2" :class="ui.caption" text="…" />
          <Pressable :if="!item.gap" :id="'reviews-page-' + item.label" @press="goToPage(item.n)" class="items-center justify-center px-3 min-h-[44px] rounded-[8px]" :class="item.active ? 'bg-[#2563eb]' : ''" accessibilityRole="button" :accessibilityState="{ selected: item.active }" :accessibilityLabel="item.active ? 'Page ' + item.label + ', current page' : 'Page ' + item.label" :testID="'reviews-page-' + item.label">
            <Text :class="item.active ? 'text-white text-[15px]' : ui.tint" :text="item.label" />
          </Pressable>
        </View>
        <Pressable id="reviews-next" @press="nextPage()" class="justify-center px-3 min-h-[44px]" accessibilityRole="button" accessibilityLabel="Next page" testID="reviews-next">
          <Text :class="currentPage() < lastPage() ? ui.tint : ui.caption" text="Next" />
        </Pressable>
      </View>
    </ScrollView>
  </View>
</template>
