<script server>
// Enumerate this route's ids at build time. Two lines on purpose: stx's SSG
// extracts this body by regex and stops at the first line starting with `}`,
// and evaluates it via `new Function`, so there is no module scope to import
// into. Absolute path because a relative specifier has no meaningful base
// inside that evaluation context. See app/Helpers/staticPaths.ts.
export async function getStaticPaths() {
  const mod = await import(`${process.cwd()}/app/Helpers/staticPaths.ts`)
  return await mod.blogPaths()
}
</script>

<script client>
  import type { BlogPost } from '~/resources/types'
  import { blogPosts } from '~/resources/data/sample'

  useHead({ title: 'Blog Post - Bench Review' })

  const post = derived<BlogPost>(() => blogPosts.find(p => p.id === Number.parseInt(params.id)) || blogPosts[0])
</script>

@extends('layouts/default')
@section('title', 'Blog Post - Bench Review')
@section('content')
  @include('Bench/Blog/BlogHeader')
  @include('Bench/Blog/Blog')
@endsection
