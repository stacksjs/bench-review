<script server>
// Enumerate this route as a SINGLE shell shared by every judge, not one page
// per judge. See judgeShellPath() in app/Helpers/staticPaths.ts for why, and
// preview.ts SHELL_REWRITES for how /judges/:id/<tab> reaches it. Two lines on
// purpose: stx's SSG extracts this body by regex and stops at the first line
// starting with `}`, and evaluates it via `new Function`, so there is no module
// scope to import into.
export async function getStaticPaths() {
  const mod = await import(`${process.cwd()}/app/Helpers/staticPaths.ts`)
  return mod.judgeShellPath()
}
</script>

@extends('layouts/default')

@section('title', 'Judge Reviews - Bench Review')

@section('content')
  @include('Bench/Judge/ProfileHeader')
  @include('Bench/Judge/JudgeTabs')
  {{-- The page container lives INSIDE Bench/Judge/Reviews, unlike the other
      three tabs. It has to: stx stamps x-cloak at build time on any open tag
      whose next closing tag comes after an interpolation, and the first thing inside
      Reviews is a run of nested divs ending in an interpolation -- so
      this wrapper was being cloaked. Every uncloak site in the runtime is
      scope-relative (the scope root plus its querySelectorAll descendants),
      and a container-wide pass only runs for views that compile a setup
      block, which a view that only pulls in components does not. Nothing ever
      lifted it, and the whole tab rendered blank. Gate check 17 now fails the
      build on any recurrence. --}}
  @include('Bench/Judge/Reviews')
@endsection
