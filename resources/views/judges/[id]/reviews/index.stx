<script server>
// Enumerate this route as a SINGLE shell shared by every judge, not one page
// per judge. See judgeShellPath() in app/Helpers/staticPaths.ts for why, and
// preview.ts SHELL_REWRITES for how /judges/:id/<tab> reaches it. Two lines on
// purpose: stx's SSG extracts this body by regex and stops at the first line
// starting with `}`, and evaluates it via `new Function`, so there is no module
// scope to import into.
export async function getStaticPaths() {
  const mod = await import(`${process.cwd()}/app/Helpers/staticPaths.ts`)
  return mod.judgeShellPath()
}
</script>

@extends('layouts/default')

@section('title', 'Judge Reviews - Bench Review')

@section('content')
  @include('Bench/Judge/ProfileHeader')
  @include('Bench/Judge/JudgeTabs')
  <div class="mx-auto px-4 py-8 sm:px-6 lg:px-8 max-w-7xl">
    @include('Bench/Judge/Reviews')
  </div>
@endsection
