<script server>
// Enumerate this route's ids at build time. Two lines on purpose: stx's SSG
// extracts this body by regex and stops at the first line starting with `}`,
// and evaluates it via `new Function`, so there is no module scope to import
// into. Absolute path because a relative specifier has no meaningful base
// inside that evaluation context. See app/Helpers/staticPaths.ts.
export async function getStaticPaths() {
  const mod = await import(`${process.cwd()}/app/Helpers/staticPaths.ts`)
  return await mod.courtPaths()
}
</script>

<script client>
  // Redirect shell for /court-houses/{id}.
  //
  // ## What this used to render
  //
  // A full courthouse header — image, name, address, stat panel — resolved
  // from the hardcoded sample list:
  //
  //     const court = derived(() => courtHouses.find(c => c.id === params.id)
  //                                 || courtHouses[0])
  //
  // That list holds four invented courthouses ("Supreme Court of California",
  // "Appellate Court of New York", ...). The real table has 202 rows, so ids
  // 1-4 rendered the WRONG courthouse and ids 5-202 fell through to
  // `courtHouses[0]` — meaning every one of the 202 built pages displayed
  // "Supreme Court of California", regardless of which courthouse it was for.
  // Verified: that string appeared in all 202 files of the built artifact.
  //
  // In a browser the damage was brief, because this page has always redirected
  // to the profile tab on mount. But the static HTML is what a crawler indexes
  // and what a no-JS visitor sees, and it named the wrong institution every
  // time.
  //
  // ## Why it is now empty
  //
  // Redirecting is this route's entire job, and has been since the tab views
  // landed: /court-houses/{id}/profile is the real page, backed by the
  // courthouse store, and it is what sitemap.xml advertises for each
  // courthouse. So there is nothing for this page to show that is not either a
  // duplicate of the profile tab or, as before, a fabrication.
  //
  // The `redirecting` state is load-bearing, not decoration: a <script client>
  // with no state/derived/effect call registers an EMPTY scope, and an empty
  // scope would take `onMount` — and therefore the redirect — down with it.
  // Binding it to the paragraph below keeps this component on the healthy
  // compile path.

  useHead({ title: 'Court House - Bench Review' })

  const redirecting = state<boolean>(true)

  onMount(() => {
    if (typeof window === 'undefined') return
    const m = window.location.pathname.match(/^\/court-houses\/(\d+)\/?$/)
    if (m) {
      navigate(`/court-houses/${m[1]}/profile`, true)
      return
    }
    // Reached with a non-numeric id, so there is nothing to redirect to.
    redirecting.set(false)
  })
</script>

@extends('layouts/default')
@section('title', 'Court House - Bench Review')
@section('content')
  <div>
    <main>
      <div class="mx-auto px-4 py-24 sm:px-6 lg:px-8 max-w-2xl text-center">
        <p class="text-gray-500 text-sm" x-class="redirecting() ? '' : 'hidden'">Opening courthouse profile…</p>
        <div x-class="redirecting() ? 'hidden' : ''">
          <h1 class="font-semibold text-gray-900 text-xl">Courthouse not found</h1>
          <p class="mt-2 text-gray-600 text-sm">
            That courthouse address doesn't look right.
            <StxLink to="/court-houses" class="font-medium text-blue-600 underline hover:text-blue-700">Browse the courthouse directory</StxLink>.
          </p>
        </div>
      </div>
    </main>
  </div>
@endsection
