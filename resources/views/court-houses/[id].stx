<script server>
// Enumerate this route's ids at build time. Two lines on purpose: stx's SSG
// extracts this body by regex and stops at the first line starting with `}`,
// and evaluates it via `new Function`, so there is no module scope to import
// into. Absolute path because a relative specifier has no meaningful base
// inside that evaluation context. See app/Helpers/staticPaths.ts.
export async function getStaticPaths() {
  const mod = await import(`${process.cwd()}/app/Helpers/staticPaths.ts`)
  return await mod.courtPaths()
}
</script>

{{--
  The canonical courthouse page.

  It used to be a redirect shell that bounced to /court-houses/:id/profile.
  That was fine while the profile tab was pre-rendered per courthouse: the tab
  carried the real content and the real per-courthouse head, and the sitemap
  pointed at it.

  The tabs are now one shared shell for all 202 courthouses, which cannot carry
  a per-courthouse head, so the sitemap points here instead. Advertising a
  client-side redirect as canonical hands a crawler a page whose only content is
  "Opening courthouse profile..." -- the complaint in #64 -- so this renders the
  courthouse itself, the same components the profile tab shows, and entitySeo
  writes the real title, description and CivicStructure node onto it.

  Mirrors /judges/:id, which has been the canonical judge page all along for the
  same reason. No client script here on purpose: the three includes carry their
  own scopes, and a block that only called useHead would register an empty one.
--}}

@extends('layouts/default')
@section('title', 'Court House - Bench Review')
@section('content')
  {{-- No <main> here: stx-standards 2.8/3.5 put it in the layout, and
       resources/layouts/default.stx already opens one. Two landmarks per page
       is invalid HTML, announces twice to a screen reader, and matters for
       routing too -- config/ui.ts sets router.container 'main', so the SPA
       router picks one of them to swap. --}}
  @include('Bench/Court/CourtHeader')
  @include('Bench/Court/CourtTabs')
  <div class="mx-auto px-4 py-8 sm:px-6 lg:px-8 max-w-7xl">
    @include('Bench/Court/CourtProfile')
  </div>
@endsection
