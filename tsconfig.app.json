{
  // App-scoped typecheck config. The shared base maps `@stacksjs/*` to the
  // framework SOURCE (`./*/src`) and globs the whole workspace, so a plain
  // `tsc` pulls vendored framework + generated migrations into the program
  // and reports ~1400 errors that say nothing about app health. Here we:
  //   - resolve `@stacksjs/*` / `stacks/*` via node_modules (their `.d.ts`,
  //     which `skipLibCheck` then ignores) instead of raw `src`,
  //   - include only app code + the ambient auto-import declarations the
  //     actions rely on (Auth, models, …),
  //   - exclude the vendored framework source, generated migrations, and
  //     the dead CMS/Logs scaffolds that import ORM request types the
  //     generator never emits.
  // Self-contained since the node_modules migration: no vendored core/tsconfig
  // to extend; @stacksjs/* resolve from node_modules .d.ts (skipLibCheck ignores
  // them). See docs/STX-MIGRATION-PLAN.md.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    // Pin strict + skipLibCheck (the old base set these; a self-contained config
    // must declare them) so the app typecheck stays meaningful.
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "Actions/*": ["./app/Actions/*"],
      "Commands/*": ["./app/Commands/*"],
      "Jobs/*": ["./app/Jobs/*"],
      "Middleware/*": ["./app/Middleware/*"],
      "Models/*": ["./app/Models/*"],
      "Notifications/*": ["./app/Notifications/*"],
      "~/*": ["./*"],
      "@/*": ["./resources/*"]
    }
  },
  "include": [
    "app",
    "routes",
    "build.ts",
    "preview.ts",
    "types/**/*.d.ts",
    // Only the row-typed model globals + server auto-imports. NOT the broad
    // storage/framework/types/*.d.ts glob — its auto-imports.d.ts types the
    // framework's own models (User/Websocket/Subscriber) as @stacksjs/orm
    // `boolean` stubs, which then win over user-models.d.ts's real row types.
    // And NOT auto-imports/globals.d.ts, which drags the framework-default
    // function barrel (craft/coupons/taggables) into the app program.
    "storage/framework/types/user-models.d.ts",
    "storage/framework/types/server-auto-imports.d.ts"
  ],
  "exclude": [
    "pantry",
    "dist",
    "**/node_modules",
    "database/migrations",
    "**/*.test.ts",
    "**/*.spec.ts",
    // Dead framework-default CMS/Logs scaffolds for models bench doesn't use
    // (Post/Page/Comment/Categorizable/Taggable/Log). They import per-model
    // `*RequestType`s that the vendored ORM once generated into core/orm/src;
    // the node_modules migration dropped that source, and published @stacksjs/orm
    // doesn't ship app-generated request types. The actions still load at runtime
    // (types erase) — they're just not part of the meaningful app typecheck.
    "app/Actions/Cms",
    "app/Actions/Logs",
    "app/Actions/LogAction.ts",
    "app/Actions/StoreEmailSubscriptionsAction.ts"
  ]
}
