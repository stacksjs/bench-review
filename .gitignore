node_modules

.DS_Store
.DS_STORE
.cache
temp
.temp
.env*
# ...but NOT the example. It is the one env file that is meant to be in the
# repo — `.env*` swept it up too, so the file new contributors are supposed to
# copy has never been tracked, which is exactly how it drifted into describing
# a Postgres app on port 3000 that this has never been (bench-review#55).
# Values in it are blanked; a real secret in here would be a mistake whatever
# the ignore rules say.
!.env.example
*.local
updates
tests/unit/coverage
dist*
# …except the iOS project's, which is the bundle Xcode Cloud compiles into the
# app: dist/native-screen.js carries every native screen. Git cannot re-include
# a path whose parent directory is excluded, so the directory itself is
# un-ignored here rather than its contents.
!storage/framework/mobile/ios/dist/

data.ms
!.gitkeep
database/stacks_testing.sqlite
database/stacks.sqlite
# SQLite database files + write-ahead-log/shared-memory sidecars must never be
# committed — the WAL holds live row pages (users, tokens, reviews). See #55.
database/*.sqlite
database/*.sqlite-wal
database/*.sqlite-shm
storage/*.sqlite
storage/*.sqlite-wal
storage/*.sqlite-shm
# Uploaded review photos are user content, not source.
storage/uploads
custom-cli
*bun-build

.fleet
.idea
.stacks
.stx
# stx working dir relocated here in v0.70.190 — ignore its build caches and
# copied assets, keep only the generated route manifests (tracked for deploy).
storage/framework/stx/*
!storage/framework/stx/routes.ts
!storage/framework/stx/route-types.d.ts
# The native projects are generated from config/mobile.ts, but the iOS one is
# COMMITTED on purpose: Xcode Cloud builds from the repository, so a project
# that exists only on the machine that generated it cannot be built there at
# all. `./buddy release:ios` regenerates it for production and commits it as
# part of cutting a build. hq.training tracks it the same way.
#
# ⚠️ What is committed must be a PRODUCTION regeneration. The e2e runner
# builds this same tree with MOBILE_URL=http://localhost:4399, and the server
# is fixed at BUILD time — a release cut from that tree would install, launch,
# and fail to reach anything on every screen. tests/unit/ios-release.test.ts
# fails the suite if a tracked file here carries a loopback URL.
storage/framework/mobile/*
!storage/framework/mobile/ios/
storage/framework/mobile/ios/build/
storage/framework/mobile/ios/**/xcuserdata/
# Never let an env file ride into the committed project.
storage/framework/mobile/ios/**/.env*

# Generated by the framework and the iOS e2e suite, never by hand. The e2e
# tree alone reaches gigabytes — every run keeps its screenshots, screen
# hierarchies and xctest logs, which is exactly what makes a failure
# diagnosable and exactly what must not be committed.
storage/framework/runtime/
storage/framework/database/
.qb
.claude
pantry
.vscode
.cursor
.zed
./test.ts

resources/assets/fonts/*.woff
resources/assets/fonts/*.woff2
storage/framework/api/storage/logs/stacks.log
storage/framework/core/storage/logs/stacks.log
storage/framework/core/cms/storage/logs/stacks.log
storage/framework/orm/src/tests/storage/logs/stacks.log
storage/framework/core/commerce/storage/logs/stacks.log
storage/framework/views/dashboard/storage/logs/stacks.log
storage/framework/core/commerce/src/tests/storage/logs/stacks.log.stx

# CourtListener bulk-data cache (quarterly, ~MBs, regenerated by scripts/ingest-courtlistener.ts)
storage/courtlistener

# iOS e2e output — screenshots, JUnit reports and Xcode derived data.
storage/framework/runtime/e2e
