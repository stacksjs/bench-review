{
  "name": "bench-review",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A judge review application powered by Stacks",
  "scripts": {
    "dev": "./buddy dev",
    "build": "bun build.ts",
    "build:stacks": "./buddy build",
    "build:offline-bundle": "bun scripts/build-offline-bundle.ts",
    "build:ios": "bun run build && bun run build:offline-bundle && ./buddy build:ios",
    "preview": "bun preview.ts",
    "start": "bun preview.ts",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "typecheck": "bun tsc --noEmit",
    "typecheck:app": "bun tsc --noEmit -p tsconfig.app.json",
    "gate": "bun run build && bun gate.ts",
    "gate:only": "bun gate.ts",
    "docs:validate": "bun scripts/validate-docs.ts",
    "ui:validate": "bun scripts/validate-ui.ts",
    "visual:validate": "bun scripts/validate-visual.ts",
    "release:validate": "bun scripts/validate-release.ts",
    "deployment:smoke": "bun scripts/smoke-deployment.ts"
  },
  "dependencies": {
    "@stacksjs/components": "^0.2.422",
    "@stacksjs/mobile": "0.75.108",
    "bun-query-builder": "0.3.5",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "ofetch": "^1.5.1",
    "perfect-debounce": "^2.1.0",
    "pretty-bytes": "^7.2.0",
    "sharp": "^0.35.5",
    "stacks": "0.75.108",
    "ts-broadcasting": "^0.0.11",
    "ts-medium-editor": "^0.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@stacksjs/stx": "^0.2.422",
    "@stacksjs/ts-i18n": "0.1.11",
    "@types/leaflet": "^1.9.22",
    "better-dx": "^0.2.37",
    "bun-git-hooks": "^0.3.3",
    "bun-plugin-auto-imports": "^0.4.3",
    "bun-plugin-stx": "^0.2.422"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  },
  "overrides": {
    "craft-native": "0.0.128"
  }
}
