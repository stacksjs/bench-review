{
  "name": "bench-review",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A judge review application powered by Stacks",
  "scripts": {
    "dev": "./buddy dev",
    "build": "bun build.ts",
    "build:stacks": "./buddy build",
    "preview": "bun preview.ts",
    "start": "bun preview.ts",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "typecheck": "bun tsc --noEmit",
    "typecheck:app": "bun tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@stacksjs/components": "^0.2.82",
    "bun-query-builder": "file:../../Projects/bun-query-builder/packages/bun-query-builder",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "ofetch": "^1.5.1",
    "perfect-debounce": "^2.1.0",
    "pretty-bytes": "^7.1.0",
    "sharp": "^0.34.5",
    "stacks": "0.70.190",
    "ts-broadcasting": "^0.0.4",
    "ts-medium-editor": "file:../ts-medium-editor"
  },
  "devDependencies": {
    "@stacksjs/stx": "^0.2.82",
    "@stacksjs/ts-i18n": "0.1.8",
    "@types/leaflet": "^1.9.21",
    "better-dx": "^0.2.17",
    "bun-git-hooks": "^0.3.1",
    "bun-plugin-auto-imports": "^0.4.1",
    "bun-plugin-stx": "^0.2.82"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
