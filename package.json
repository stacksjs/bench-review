{
  "name": "bench-review",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A judge review application powered by Stacks",
  "scripts": {
    "dev": "./buddy dev",
    "build": "bun build.ts",
    "build:stacks": "./buddy build",
    "preview": "bun preview.ts",
    "start": "bun preview.ts",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "typecheck": "bun tsc --noEmit",
    "typecheck:app": "bun tsc --noEmit -p tsconfig.app.json",
    "gate": "bun run build && bun gate.ts",
    "gate:only": "bun gate.ts"
  },
  "dependencies": {
    "@stacksjs/components": "^0.2.216",
    "bun-query-builder": "^0.2.60",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "ofetch": "^1.5.1",
    "perfect-debounce": "^2.1.0",
    "pretty-bytes": "^7.1.1",
    "sharp": "^0.35.3",
    "stacks": "0.72.49",
    "ts-broadcasting": "^0.0.10",
    "ts-medium-editor": "^0.1.6"
  },
  "devDependencies": {
    "@stacksjs/stx": "^0.2.216",
    "@stacksjs/ts-i18n": "0.1.11",
    "@types/leaflet": "^1.9.22",
    "better-dx": "^0.2.25",
    "bun-git-hooks": "^0.3.3",
    "bun-plugin-auto-imports": "^0.4.1",
    "bun-plugin-stx": "^0.2.216"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
